            "trailingPerformerIds": [],
            "en-US": "As long as you remember me."
          },
          {
            "id": "full-000038",
            "order": 37,
            "japanese": "\"もう一度！\"",
            "zh-CN": "“再一次！”",
            "stanzaBreakBefore": true,
