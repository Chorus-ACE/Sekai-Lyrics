            ],
            "trailingPerformerIds": [],
            "en-US": "It’s not going to end,"
          },
          {
            "id": "full-000037",
            "order": 36,
            "japanese": "キミが覚えていてくれるなら。",
            "zh-CN": "只要你依然愿意为我铭记在心。",
            "segments": [
              {
                "text": "キミが覚えていてくれるなら。",
                "performerIds": [],
                "ruby": [
