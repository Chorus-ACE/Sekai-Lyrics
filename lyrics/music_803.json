    }
  ],
  "lines": [
    {
      "id": "line-1",
      "order": 0,
      "japanese": "「頑張れ」　でも　「大丈夫」　でもない",
      "zh-CN": "既不是「加油」　也不是「没事的」",
      "en-US": "",
      "segments": [
        {
          "text": "「頑張れ」　でも　「大丈夫」　でもない",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-2",
      "order": 1,
      "japanese": "「君ならできる」　でもない",
      "zh-CN": "更不是「你一定可以的」",
      "en-US": "",
      "segments": [
        {
          "text": "「君ならできる」　でもない",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-3",
      "order": 2,
      "japanese": "あの日僕が言われたかった",
      "zh-CN": "那一天我真正渴望听到的",
      "en-US": "",
      "segments": [
        {
          "text": "あの日僕が言われたかった",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-4",
      "order": 3,
      "japanese": "言葉をずっと探してる",
      "zh-CN": "那句话 我一直苦苦找寻至今",
      "en-US": "",
      "segments": [
        {
          "text": "言葉をずっと探してる",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-5",
      "order": 4,
      "japanese": "雨にも負けて　風にも負けて",
      "zh-CN": "既输给了骤雨　也败给了狂风",
      "en-US": "",
      "stanzaBreakBefore": true,
      "segments": [
        {
          "text": "雨にも負けて　風にも負けて",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-6",
      "order": 5,
      "japanese": "丈夫な心も無いが",
      "zh-CN": "更没有一颗坚韧强壮的心",
      "en-US": "",
      "segments": [
        {
          "text": "丈夫な心も無いが",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-7",
      "order": 6,
      "japanese": "ふと見上げた曇り空が",
      "zh-CN": "但偶然间仰望的那片阴云天空",
      "en-US": "",
      "segments": [
        {
          "text": "ふと見上げた曇り空が",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-8",
      "order": 7,
      "japanese": "優しく笑って見えた",
      "zh-CN": "看起来仿佛正温柔地对我微笑",
      "en-US": "",
      "segments": [
        {
          "text": "優しく笑って見えた",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-9",
      "order": 8,
      "japanese": "生きる意味なんて　理由なんて",
      "zh-CN": "所谓活着的意义　所谓存在的理由",
      "en-US": "",
      "stanzaBreakBefore": true,
      "segments": [
        {
          "text": "生きる意味なんて　理由なんて",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-10",
      "order": 9,
      "japanese": "わからなくて当たり前だよ",
      "zh-CN": "弄不明白本就是理所当然的啊",
      "en-US": "",
      "segments": [
        {
          "text": "わからなくて当たり前だよ",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-11",
      "order": 10,
      "japanese": "空に免じて今日は生きよう",
      "zh-CN": "就看在天空的面子上 今天且活着吧",
      "en-US": "",
      "stanzaBreakBefore": true,
      "segments": [
        {
          "text": "空に免じて今日は生きよう",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-12",
      "order": 11,
      "japanese": "空に免じて今日は帰ろう",
      "zh-CN": "就看在天空的面子上 今天且回家吧",
      "en-US": "",
      "segments": [
        {
          "text": "空に免じて今日は帰ろう",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-13",
      "order": 12,
      "japanese": "ひび割れた心　繋ぎ止める",
      "zh-CN": "将支离破碎的心　重新缝合连缀",
      "en-US": "",
      "segments": [
        {
          "text": "ひび割れた心　繋ぎ止める",
          "performerIds": [
            21
          ]
        }
      ]
    },
    {
      "id": "line-14",
      "order": 13,
      "japanese": "空に免じて僕を許そう",
      "zh-CN": "就看在天空的面子上 宽恕这样的我吧",
      "en-US": "",
      "segments": [
        {
          "text": "空に免じて僕を許そう",
          "performerIds": [
            21
          ]
        }
      ]
    }
  ]
}
