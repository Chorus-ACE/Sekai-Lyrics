            "segments": [
              {
                "text": "キラキラ光る瞳に僕が映るの",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "キラキラ"
                  },
                  {
                    "text": "光",
                    "reading": "ひか"
                  },
                  {
                    "text": "る"
                  },
                  {
                    "text": "瞳",
                    "reading": "ひとみ"
                  },
                  {
