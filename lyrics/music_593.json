                  {
                    "text": "を"
                  },
                  {
                    "text": "付",
                    "reading": "つ"
                  },
                  {
                    "text": "けた"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Became something more when I'm with you"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "どんどん季節が過ぎて",
            "zh-CN": "季节飞速流转更替",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "どんどん季節が過ぎて",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "どんどん"
                  },
                  {
                    "text": "季節",
                    "reading": "きせつ"
