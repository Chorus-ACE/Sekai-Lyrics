                    "reading": "うつ"
                  },
                  {
                    "text": "るの"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I can see myself reflected in those sparkling eyes"
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "雪の結晶が 奏でるメロディー",
            "zh-CN": "雪之结晶 奏响的动人旋律",
            "segments": [
              {
                "text": "雪の結晶が 奏でるメロディー",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "雪",
                    "reading": "ゆき"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "結晶",
                    "reading": "けしょう"
                  },
                  {
                    "text": "が "
                  },
                  {
                    "text": "奏",
                    "reading": "かな"
                  },
                  {
                    "text": "でるメロディー"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The melody is played by the snow crystals"
