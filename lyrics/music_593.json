                  },
                  {
                    "text": "溶",
                    "reading": "と"
                  },
                  {
                    "text": "けるまで"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Until the crystal snow magic fades away,"
