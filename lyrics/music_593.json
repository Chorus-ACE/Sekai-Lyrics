        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "煌めいた星が照らす氷の粒",
            "zh-CN": "闪耀繁星照亮的粒粒冰晶",
            "segments": [
              {
                "text": "煌めいた星が照らす氷の粒",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "煌",
                    "reading": "きら"
                  },
                  {
                    "text": "めいた"
                  },
                  {
                    "text": "星",
                    "reading": "ほし"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "照",
                    "reading": "て"
                  },
                  {
                    "text": "らす"
                  },
                  {
                    "text": "氷",
                    "reading": "こおり"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "粒",
                    "reading": "つぶ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The beads of ice are illuminated by the twinkling stars"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "宝石みたいだね お出かけの時間だ",
            "zh-CN": "宛如宝石一般呢 到了出发的时间啦",
            "segments": [
              {
                "text": "宝石みたいだね お出かけの時間だ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "宝石",
                    "reading": "ほうせき"
                  },
                  {
                    "text": "みたいだね お"
                  },
                  {
                    "text": "出",
                    "reading": "で"
                  },
                  {
                    "text": "かけの"
                  },
                  {
                    "text": "時間",
                    "reading": "じかん"
                  },
                  {
                    "text": "だ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "They look just like jewels, don't they? It's time for us to go on a trip"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "通り過ぎてたトキメキの合図が",
            "zh-CN": "曾悄然掠过的心动信号",
            "segments": [
              {
                "text": "通り過ぎてたトキメキの合図が",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "通",
                    "reading": "とお"
                  },
                  {
                    "text": "り"
                  },
                  {
                    "text": "過",
                    "reading": "す"
                  },
                  {
                    "text": "ぎてたトキメキの"
                  },
                  {
                    "text": "合図",
                    "reading": "あいず"
                  },
                  {
                    "text": "が"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The fluttering signal that passed me by"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "きみといると色を付けた",
            "zh-CN": "只要与你在一起便染上了绚丽色彩",
            "segments": [
              {
                "text": "きみといると色を付けた",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "きみといると"
                  },
                  {
                    "text": "色",
                    "reading": "いろ"
