            ],
            "trailingPerformerIds": [],
            "en-US": "One after another, the season changes"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "置いてけぼりになる僕 Uh-Uh",
            "zh-CN": "唯留我被抛在原地 Uh-Uh",
            "segments": [
              {
                "text": "置いてけぼりになる僕 Uh-Uh",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "置",
                    "reading": "お"
                  },
                  {
                    "text": "いてけぼりになる"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": " Uh-Uh"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Leaving me behind Uh-Uh"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "ノックノック",
            "zh-CN": "咚咚敲门",
            "segments": [
              {
                "text": "ノックノック",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ノックノック"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Knock, knock"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "きみは笑顔で訪ねてきたね",
            "zh-CN": "你带着满脸笑容前来拜访了我呢",
            "segments": [
              {
                "text": "きみは笑顔で訪ねてきたね",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "きみは"
                  },
                  {
                    "text": "笑顔",
                    "reading": "えがお"
                  },
                  {
                    "text": "で"
                  },
                  {
                    "text": "訪",
                    "reading": "たず"
                  },
                  {
                    "text": "ねてきたね"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "You smiled as you came to visit me"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "輝いた雪が 舞い降りる度",
            "zh-CN": "璀璨白雪 每次翩然飘落",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "輝いた雪が 舞い降りる度",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "輝",
                    "reading": "かがや"
                  },
                  {
                    "text": "いた"
                  },
                  {
                    "text": "雪",
                    "reading": "ゆき"
                  },
                  {
                    "text": "が "
                  },
                  {
                    "text": "舞",
                    "reading": "ま"
                  },
                  {
                    "text": "い"
