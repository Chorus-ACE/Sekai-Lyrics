                  },
                  {
                    "text": "えてあげまーす！"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Come now everyone, I'll explain it for you!"
          },
          {
            "id": "full-000007",
            "order": 6,
