            "trailingPerformerIds": [],
            "en-US": "You're all excited, huh? Hey, Ondine?"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "ハイハーイ！",
            "zh-CN": "好——的！",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "ハイハーイ！",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ハイハーイ！"
