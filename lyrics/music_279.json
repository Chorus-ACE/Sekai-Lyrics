                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Everyone strained their ears at the water's edge,"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "わくわくするね　ねぇ、オンディーヌ？",
            "zh-CN": "让人心潮澎湃呢 呐，温蒂妮？",
            "segments": [
              {
                "text": "わくわくするね　ねぇ、オンディーヌ？",
