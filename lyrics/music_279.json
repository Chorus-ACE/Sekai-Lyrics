          {
            "id": "full-000001",
            "order": 0,
            "japanese": "どうして　みんなが　幸せなの？",
            "zh-CN": "为什么 大家都 这么幸福呢？",
            "segments": [
              {
                "text": "どうして　みんなが　幸せなの？",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "どうして　みんなが　"
                  },
                  {
                    "text": "幸",
                    "reading": "しあわ"
                  },
                  {
                    "text": "せなの？"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Why is it that you are all so happy?"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "この世界のこと　聞きたいって、知りたいって",
            "zh-CN": "想打听、想了解 这个世界的事情",
            "segments": [
              {
                "text": "この世界のこと　聞きたいって、知りたいって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "この"
                  },
                  {
                    "text": "世界",
                    "reading": "せかい"
                  },
                  {
                    "text": "のこと　"
                  },
                  {
                    "text": "聞",
                    "reading": "き"
                  },
                  {
                    "text": "きたいって、"
                  },
                  {
                    "text": "知",
                    "reading": "し"
                  },
                  {
                    "text": "りたいって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The things of this world, you say you want to hear them? To know them?"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "水辺の公園で　みんなが耳を澄ませて",
            "zh-CN": "在水边的公园里 大家都侧耳倾听",
