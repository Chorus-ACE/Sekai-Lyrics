              {
                "text": "水辺の公園で　みんなが耳を澄ませて",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "水辺",
                    "reading": "みずべ"
                  },
                  {
                    "text": "の"
                  },
                  {
