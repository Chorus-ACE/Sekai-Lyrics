                    "text": "に　ココロ"
                  },
                  {
                    "text": "決",
                    "reading": "き"
                  },
                  {
                    "text": "めたんだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I've made up my mind long ago"
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "照らし出して！　グリーンライツ",
            "zh-CN": "照亮一切吧！ 绿光之灯",
            "segments": [
              {
                "text": "照らし出して！　グリーンライツ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "照",
                    "reading": "て"
                  },
                  {
                    "text": "らし"
                  },
                  {
                    "text": "出",
                    "reading": "だ"
                  },
                  {
                    "text": "して！　グリーンライツ"
                  }
                ]
              }
