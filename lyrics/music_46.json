        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "照らし出して！　グリーンライツ",
            "zh-CN": "照亮一切吧！ 绿光之灯",
            "segments": [
              {
                "text": "照らし出して！　グリーンライツ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "照",
                    "reading": "て"
                  },
                  {
                    "text": "らし"
                  },
                  {
                    "text": "出",
                    "reading": "だ"
                  },
                  {
                    "text": "して！　グリーンライツ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Light up the greenlights!"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "広がる未来を　きっと　いつか",
            "zh-CN": "照亮辽阔延伸的未来 一定 会在未来的某一天",
            "segments": [
              {
                "text": "広がる未来を　きっと　いつか",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "広",
                    "reading": "ひろ"
                  },
                  {
                    "text": "がる"
                  },
                  {
                    "text": "未来",
                    "reading": "みらい"
                  },
                  {
                    "text": "を　きっと　いつか"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Until they shine on the spreading future"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "キミを照らすまで",
            "zh-CN": "直至将你也彻底照亮",
            "segments": [
              {
                "text": "キミを照らすまで",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "キミを"
                  },
                  {
                    "text": "照",
                    "reading": "て"
                  },
                  {
                    "text": "らすまで"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "and you, surely, someday"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "改めて言うことでもないけど",
            "zh-CN": "虽然也不是什么需要郑重其事挑明的话",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "改めて言うことでもないけど",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "改",
                    "reading": "あらた"
                  },
                  {
                    "text": "めて"
                  },
                  {
                    "text": "言",
                    "reading": "い"
                  },
                  {
                    "text": "うことでもないけど"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Again, it's not like I have nothing particular to say,"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "今だからこそ言わせて",
            "zh-CN": "但正因是此时此刻 才想让我说出口",
            "segments": [
              {
                "text": "今だからこそ言わせて",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "今",
                    "reading": "いま"
                  },
                  {
                    "text": "だからこそ"
                  },
                  {
                    "text": "言",
                    "reading": "い"
                  },
                  {
                    "text": "わせて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "but that's why now, I'm able to say it"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "あの日キミが見つけてくれること",
            "zh-CN": "那一天能被你所发现",
            "segments": [
              {
                "text": "あの日キミが見つけてくれること",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "あの"
                  },
                  {
                    "text": "日",
                    "reading": "ひ"
                  },
                  {
                    "text": "キミが"
                  },
                  {
                    "text": "見",
                    "reading": "み"
                  },
                  {
                    "text": "つけてくれること"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The fact that you found me that day"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "何となく予感してたんだ",
            "zh-CN": "我冥冥中早就有所预感了",
            "segments": [
              {
                "text": "何となく予感してたんだ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "何",
                    "reading": "なん"
                  },
                  {
                    "text": "となく"
                  },
                  {
                    "text": "予感",
                    "reading": "よかん"
                  },
                  {
                    "text": "してたんだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "for some reason, I had a hunch about that"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "走り出した　キミにもっと",
            "zh-CN": "想要为奔跑而出的你",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "走り出した　キミにもっと",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "走",
                    "reading": "はし"
                  },
                  {
                    "text": "り"
                  },
                  {
                    "text": "出",
                    "reading": "だ"
                  },
                  {
                    "text": "した　キミにもっと"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I want to help you more,"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "チカラをあげたくて",
            "zh-CN": "给予更多更多的力量",
            "segments": [
              {
                "text": "チカラをあげたくて",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "チカラをあげたくて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "you who've began to run"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "ずっと　前に　ココロ決めたんだ",
            "zh-CN": "我早在很久以前 就已下定了决心",
            "segments": [
              {
                "text": "ずっと　前に　ココロ決めたんだ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ずっと　"
