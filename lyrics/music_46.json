                  },
                  {
                    "text": "を"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Until they shine on the faraway future"
          },
          {
            "id": "full-000013",
            "order": 12,
            "japanese": "きっと　いつか　キミを照らすまで",
            "zh-CN": "一定 会在未来的某一天 直至将你也彻底照亮",
            "segments": [
              {
                "text": "きっと　いつか　キミを照らすまで",
                "performerIds": [],
                "ruby": [
