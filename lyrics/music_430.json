        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "嬌声は誘惑じゃない吐息が溜まりすぎなだけです",
            "zh-CN": "娇喘可不是诱惑 只是积攒了太多叹息而已",
            "segments": [
              {
                "text": "嬌声は誘惑じゃない吐息が溜まりすぎなだけです",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "嬌声",
                    "reading": "きょうせい"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "誘惑",
                    "reading": "ゆうわく"
                  },
                  {
                    "text": "じゃない"
                  },
                  {
                    "text": "吐息",
                    "reading": "といき"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "溜",
                    "reading": "た"
                  },
                  {
                    "text": "まりすぎなだけです"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "This coquettish voice is no seduction, it’s just the result of sighs piling up too much."
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "膨張と酸素のパーティーこの肺は常軌を逸している",
            "zh-CN": "膨胀与氧气的派对 这肺部简直脱离了常规",
            "segments": [
              {
                "text": "膨張と酸素のパーティーこの肺は常軌を逸している",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "膨張",
                    "reading": "ぼうちょう"
                  },
                  {
                    "text": "と"
                  },
                  {
                    "text": "酸素",
                    "reading": "さんそ"
                  },
                  {
                    "text": "のパーティーこの"
                  },
                  {
                    "text": "肺",
                    "reading": "はい"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "常軌",
                    "reading": "じょうき"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "逸",
                    "reading": "いっ"
                  },
                  {
                    "text": "している"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "When my lungs swell, they throw a party of oxygen; they’re going off the rails"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "吸いすぎて漏れる",
            "zh-CN": "吸气过猛而漏了出去",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "吸いすぎて漏れる",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "吸",
                    "reading": "す"
                  },
                  {
                    "text": "いすぎて"
                  },
                  {
                    "text": "漏",
                    "reading": "も"
                  },
                  {
                    "text": "れる"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I inhale too much and it leaks out."
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "I wanna be Diva 声帯のBebop",
            "zh-CN": "I wanna be Diva 声带的Bebop",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "I wanna be Diva 声帯のBebop",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "I wanna be Diva "
