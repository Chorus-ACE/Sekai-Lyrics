                  {
                    "text": "声帯",
                    "reading": "せいたい"
                  },
                  {
                    "text": "のBebop"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I wanna be Diva, playing bebop with my vocal cords."
          },
          {
            "id": "full-000005",
