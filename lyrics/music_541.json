        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "それから僕たちは肩を組んで",
            "zh-CN": "自那之后我们搭起彼此的肩膀",
            "segments": [
              {
                "text": "それから僕たちは肩を組んで",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "それから"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "たちは"
                  },
                  {
                    "text": "肩",
                    "reading": "かた"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "組",
                    "reading": "く"
                  },
                  {
                    "text": "んで"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Right after, we placed our arms around each other’s shoulders"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "「何かを起こそう、やり返してやるんだ」って",
            "zh-CN": "豪言「掀起一番风浪吧、好好回敬他们一番」",
            "segments": [
              {
                "text": "「何かを起こそう、やり返してやるんだ」って",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "「"
                  },
                  {
                    "text": "何",
                    "reading": "なに"
                  },
                  {
                    "text": "かを"
                  },
                  {
                    "text": "起",
                    "reading": "お"
                  },
                  {
                    "text": "こそう、やり"
                  },
                  {
                    "text": "返",
                    "reading": "かえ"
                  },
                  {
                    "text": "してやるんだ」って"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "“Let’s make something happen! We’ll show them!” we said"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "何となく、確かに",
            "zh-CN": "虽漫不经心 却真切无比",
            "segments": [
              {
                "text": "何となく、確かに",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "何",
                    "reading": "なん"
                  },
                  {
                    "text": "となく、"
                  },
                  {
                    "text": "確",
                    "reading": "たし"
                  },
                  {
                    "text": "かに"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "For some reason, though it was certainly"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "巫山戯て、真剣に思っていた",
            "zh-CN": "虽嬉皮笑脸 却无比认真地笃信着",
            "segments": [
              {
                "text": "巫山戯て、真剣に思っていた",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "巫山戯",
                    "reading": "ふざけ"
                  },
                  {
                    "text": "て、"
                  },
                  {
                    "text": "真剣",
                    "reading": "しんけん"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "思",
                    "reading": "おも"
                  },
                  {
                    "text": "っていた"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "a joke, we took it seriously"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "「望みは無いよ、やめておけって",
            "zh-CN": "「毫无希望的啦 趁早放弃吧",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "「望みは無いよ、やめておけって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "「"
                  },
                  {
                    "text": "望",
                    "reading": "のぞ"
                  },
                  {
                    "text": "みは"
                  },
                  {
                    "text": "無",
                    "reading": "な"
                  },
                  {
                    "text": "いよ、やめておけって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "“It’s hopeless, just cut your losses,’ they said,"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "博打だ、どうせ外れだよ",
            "zh-CN": "不过是场豪赌 反正肯定会落空",
            "segments": [
              {
                "text": "博打だ、どうせ外れだよ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "博打",
                    "reading": "ばくち"
                  },
                  {
                    "text": "だ、どうせ"
                  },
                  {
                    "text": "外",
                    "reading": "はず"
                  },
                  {
                    "text": "れだよ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "‘It’s a gamble, it’s not gonna work,"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "現実は甘くないんだって",
            "zh-CN": "现实可没那么美好天真",
            "segments": [
              {
                "text": "現実は甘くないんだって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "現実",
                    "reading": "げんじつ"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "甘",
                    "reading": "あま"
                  },
                  {
                    "text": "くないんだって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Reality check: Life isn’t fair,"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "ヒーローなんて成れやしないんだ」",
            "zh-CN": "根本不可能成为什么英雄的」",
            "segments": [
              {
                "text": "ヒーローなんて成れやしないんだ」",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ヒーローなんて"
                  },
                  {
                    "text": "成",
                    "reading": "な"
                  },
                  {
                    "text": "れやしないんだ」"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "You’ll never be good enough to be the hero”"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "そんなこと言われなくたって",
            "zh-CN": "这种事情就算没人提醒",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "そんなこと言われなくたって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "そんなこと"
                  },
                  {
                    "text": "言",
                    "reading": "い"
                  },
                  {
                    "text": "われなくたって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Even though they never said that exactly,"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "知ってるよだって今だって",
            "zh-CN": "我也早就心知肚明 因为哪怕是现在",
            "segments": [
              {
                "text": "知ってるよだって今だって",
