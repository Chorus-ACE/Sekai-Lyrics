            "trailingPerformerIds": [],
            "en-US": "The anxiety’s edging me closer to tears"
          },
          {
            "id": "full-000012",
            "order": 11,
            "japanese": "君と同じように",
            "zh-CN": "就和你一模一样",
            "segments": [
              {
