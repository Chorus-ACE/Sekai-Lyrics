            "trailingPerformerIds": [],
            "en-US": "I’ve reached the point of no return anyway"
          },
          {
            "id": "full-000020",
            "order": 19,
            "japanese": "君が立つ場所はきっと",
            "zh-CN": "你所伫立的那个位置",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "君が立つ場所はきっと",
