                  {
                    "text": "知",
                    "reading": "し"
                  },
                  {
                    "text": "ってるよだって"
                  },
                  {
                    "text": "今",
                    "reading": "いま"
                  },
                  {
                    "text": "だって"
                  }
                ]
              }
