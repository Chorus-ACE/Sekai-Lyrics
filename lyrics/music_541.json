                    "reading": "しゅじんこう"
                  },
                  {
                    "text": "だって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I’m the main protagonist in this story, after all"
          },
          {
            "id": "full-000017",
            "order": 16,
            "japanese": "信じ続ければ真実に",
            "zh-CN": "只要坚信到底就会化作真实",
            "stanzaBreakBefore": true,
            "segments": [
