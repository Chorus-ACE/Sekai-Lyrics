            "trailingPerformerIds": [],
            "en-US": "I could already tell what they were thinking"
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "不安で泣き出しそうになる",
            "zh-CN": "我也依旧不安得几欲落泪",
            "segments": [
