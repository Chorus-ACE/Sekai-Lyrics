        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "小さな窓の中",
            "zh-CN": "在狭小的窗扉之中",
            "segments": [
              {
                "text": "小さな窓の中",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "小",
                    "reading": "ちい"
                  },
                  {
                    "text": "さな"
                  },
                  {
                    "text": "窓",
                    "reading": "まど"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "中",
                    "reading": "なか"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "From a small window,"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "流れる光景を",
            "zh-CN": "窗外流转掠过的光景",
            "segments": [
              {
                "text": "流れる光景を",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "流",
                    "reading": "なが"
                  },
                  {
                    "text": "れる"
                  },
                  {
                    "text": "光景",
                    "reading": "こうけい"
                  },
                  {
                    "text": "を"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I was absently looking at"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "ぼんやり眺めてた",
            "zh-CN": "我只是怔怔地凝望着",
            "segments": [
              {
                "text": "ぼんやり眺めてた",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ぼんやり"
                  },
                  {
                    "text": "眺",
                    "reading": "なが"
                  },
                  {
                    "text": "めてた"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "A flowing sight."
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "僕には馴染めない",
            "zh-CN": "我无法融入其中",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "僕には馴染めない",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "には"
                  },
                  {
                    "text": "馴染",
                    "reading": "なじ"
                  },
                  {
                    "text": "めない"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I can't fit in."
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "僕には似合わない",
            "zh-CN": "那并不适合我",
            "segments": [
              {
                "text": "僕には似合わない",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "には"
                  },
                  {
                    "text": "似合",
                    "reading": "にあ"
                  },
                  {
                    "text": "わない"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I don't belong here."
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "ただそう思ってたんだ",
            "zh-CN": "我曾经只是这般认为",
            "segments": [
              {
                "text": "ただそう思ってたんだ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ただそう"
                  },
                  {
                    "text": "思",
                    "reading": "おも"
                  },
                  {
                    "text": "ってたんだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "That's all that I was thinking"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "出会う前は…",
            "zh-CN": "在与你相遇之前……",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "出会う前は…",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "出会",
                    "reading": "であ"
                  },
                  {
                    "text": "う"
                  },
                  {
                    "text": "前",
                    "reading": "まえ"
                  },
                  {
                    "text": "は…"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Until we met..."
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "胸おどる姿と",
            "zh-CN": "令人雀跃欢欣的身影",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "胸おどる姿と",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "胸",
                    "reading": "むね"
                  },
                  {
                    "text": "おどる"
                  },
                  {
                    "text": "姿",
                    "reading": "すがた"
                  },
                  {
                    "text": "と"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "With a heart-pounding figure"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "心に染み入るその声",
            "zh-CN": "与沁入心扉的那道歌声",
            "segments": [
              {
                "text": "心に染み入るその声",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "心",
                    "reading": "こころ"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "染",
                    "reading": "し"
                  },
                  {
                    "text": "み"
                  },
                  {
                    "text": "入",
                    "reading": "い"
                  },
                  {
                    "text": "るその"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "And that voice that permeates my heart"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "遠く離れていても",
            "zh-CN": "纵然相隔遥远",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "遠く離れていても",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "遠",
                    "reading": "とお"
                  },
                  {
                    "text": "く"
                  },
                  {
                    "text": "離",
                    "reading": "はな"
                  },
                  {
                    "text": "れていても"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Even if you're far away"
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "遮られていても",
            "zh-CN": "纵然重重受阻",
            "segments": [
              {
                "text": "遮られていても",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "遮",
                    "reading": "さえぎ"
                  },
                  {
                    "text": "られていても"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Even if you're cut off"
          },
          {
            "id": "full-000012",
            "order": 11,
            "japanese": "僕へと届く君のレゾナンス",
            "zh-CN": "你那抵达我心底的共鸣",
            "segments": [
              {
                "text": "僕へと届く君のレゾナンス",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "へと"
                  },
                  {
                    "text": "届",
                    "reading": "とど"
                  },
                  {
                    "text": "く"
                  },
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "のレゾナンス"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Your resonance reaches me"
          },
          {
            "id": "full-000013",
            "order": 12,
            "japanese": "明るいときの声も",
            "zh-CN": "无论欢欣明朗时的声音",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "明るいときの声も",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "明",
                    "reading": "あか"
                  },
                  {
                    "text": "るいときの"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  },
                  {
                    "text": "も"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Your voice when it's bright"
          },
          {
            "id": "full-000014",
            "order": 13,
            "japanese": "暗いときの声も",
            "zh-CN": "还是低落黯淡时的声音",
            "segments": [
              {
                "text": "暗いときの声も",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "暗",
                    "reading": "くら"
                  },
                  {
                    "text": "いときの"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  },
                  {
                    "text": "も"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "As well as your voice when it's dark"
          },
          {
            "id": "full-000015",
            "order": 14,
            "japanese": "何故だろう誰の声より響くんだ",
            "zh-CN": "不知为何却比任何人的声音都更加响亮动人",
            "segments": [
              {
                "text": "何故だろう誰の声より響くんだ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "何故",
                    "reading": "なぜ"
                  },
                  {
                    "text": "だろう"
                  },
                  {
                    "text": "誰",
                    "reading": "だれ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  },
                  {
                    "text": "より"
                  },
                  {
                    "text": "響",
                    "reading": "ひび"
                  },
                  {
                    "text": "くんだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I wonder why it resonates more than anyone else's voice"
          },
          {
            "id": "full-000016",
            "order": 15,
            "japanese": "不思議だよね",
            "zh-CN": "真的很不可思议呢",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "不思議だよね",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "不思議",
                    "reading": "ふしぎ"
                  },
                  {
                    "text": "だよね"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "It's strange, isn't it?"
          },
          {
            "id": "full-000017",
            "order": 16,
            "japanese": "二人の言葉が重なって",
            "zh-CN": "彼此的话语交织重叠",
            "segments": [
              {
                "text": "二人の言葉が重なって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "二人",
                    "reading": "ふたり"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "言葉",
                    "reading": "ことば"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "重",
                    "reading": "かさ"
                  },
                  {
                    "text": "なって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "How the words of two people overlap"
          },
          {
            "id": "full-000018",
            "order": 17,
            "japanese": "君の感情と歌声と僕の心ふるわす",
            "zh-CN": "你的情感与歌声将我的心灵深深撼动",
            "segments": [
              {
                "text": "君の感情と歌声と僕の心ふるわす",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "感情",
                    "reading": "かんじょう"
                  },
                  {
                    "text": "と"
                  },
                  {
                    "text": "歌声",
                    "reading": "うたごえ"
                  },
                  {
                    "text": "と"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "心",
                    "reading": "こころ"
                  },
                  {
                    "text": "ふるわす"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "With your emotions and your singing voice you make my heart tremble"
          }
        ]
