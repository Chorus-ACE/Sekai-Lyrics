                    "text": "評判",
                    "reading": "ひょうばん"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "娘",
                    "reading": "むすめ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "She is the talk of the neighborhood"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "そんな彼女の悩みごとは",
            "zh-CN": "这样的一位她心中的烦恼",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "そんな彼女の悩みごとは",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "そんな"
                  },
                  {
                    "text": "彼女",
                    "reading": "かのじょ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "悩",
                    "reading": "なや"
                  },
                  {
                    "text": "みごとは"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Always on her mind"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "愛するあの人の浮気症",
            "zh-CN": "是深爱着的那个人生性风流",
            "segments": [
              {
                "text": "愛するあの人の浮気症",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "愛",
                    "reading": "あい"
                  },
                  {
                    "text": "するあの"
