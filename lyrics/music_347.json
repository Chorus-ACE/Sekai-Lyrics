                    "reading": "うわきしょう"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Was her loved one's infidelity"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "「私というものがありながら",
            "zh-CN": "「明明已经有了我",
            "segments": [
              {
                "text": "「私というものがありながら",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "「"
                  },
                  {
                    "text": "私",
                    "reading": "わたし"
                  },
                  {
                    "text": "というものがありながら"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "“Despite having someone like me,"
          },
