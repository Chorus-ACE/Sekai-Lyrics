                  },
                  {
                    "text": "めましょう」"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "\"Come, let’s begin tailoring\""
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "円尾坂の片隅にある",
            "zh-CN": "在圆尾坂的角落里",
