          {
            "id": "full-000001",
            "order": 0,
            "japanese": "「さあ、仕立を始めましょう」",
            "zh-CN": "「来吧，开始裁剪缝纫吧」",
            "segments": [
              {
                "text": "「さあ、仕立を始めましょう」",
