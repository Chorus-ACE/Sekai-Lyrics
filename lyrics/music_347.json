                    "reading": "かたすみ"
                  },
                  {
                    "text": "にある"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "In the corner of Enbizaka"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "仕立屋の若き女主人",
            "zh-CN": "有位裁缝店的年轻女掌柜",
