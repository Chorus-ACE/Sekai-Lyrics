                  },
                  {
                    "text": "で"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Good-natured with a skilled hand,"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "近所でも評判の娘",
            "zh-CN": "是街坊邻里交口称赞的姑娘",
