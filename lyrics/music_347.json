                  {
                    "text": "き"
                  },
                  {
                    "text": "女主人",
                    "reading": "おんなしゅじん"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "A young woman owns a tailor shop"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "気立てのよさと確かな腕で",
