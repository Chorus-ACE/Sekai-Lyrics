                    "reading": "いえ"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "帰",
                    "reading": "かえ"
                  },
                  {
                    "text": "ってきやしない」"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "He never comes home”"
          },
