        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "もしも僕がうそつきなら",
            "zh-CN": "倘若我是个满嘴谎言的骗子",
            "segments": [
              {
                "text": "もしも僕がうそつきなら",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "もしも"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "がうそつきなら"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "If I were a liar,"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "こんな僕のこと　叱ってくれたかな？",
            "zh-CN": "是否会狠狠斥责这样的我呢？",
            "segments": [
              {
                "text": "こんな僕のこと　叱ってくれたかな？",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "こんな"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "のこと　"
                  },
                  {
                    "text": "叱",
                    "reading": "しか"
                  },
                  {
                    "text": "ってくれたかな？"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "would you scold me?"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "そんなたくさんの「もしも話が」",
            "zh-CN": "许许多多这般的「假设故事」",
            "segments": [
              {
                "text": "そんなたくさんの「もしも話が」",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "そんなたくさんの「もしも"
                  },
                  {
                    "text": "話",
                    "reading": "ばなし"
                  },
                  {
                    "text": "が」"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Many \"if\"s like these (vaguely) appear"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "僕の部屋にさ　浮かんで行くんだよ。",
            "zh-CN": "正在我的房间里 渐渐浮现飘荡哦。",
            "segments": [
              {
                "text": "僕の部屋にさ　浮かんで行くんだよ。",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "部屋",
                    "reading": "へや"
                  },
                  {
                    "text": "にさ　"
                  },
                  {
                    "text": "浮",
                    "reading": "う"
                  },
                  {
                    "text": "かんで"
                  },
                  {
                    "text": "行",
                    "reading": "い"
                  },
                  {
                    "text": "くんだよ。"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "to me when I'm (alone) in my room."
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "何も無い日々から",
            "zh-CN": "从空无一物的岁月里",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "何も無い日々から",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "何",
                    "reading": "なに"
                  },
                  {
                    "text": "も"
                  },
                  {
                    "text": "無",
                    "reading": "な"
                  },
                  {
                    "text": "い"
                  },
                  {
                    "text": "日々",
                    "reading": "ひび"
                  },
                  {
                    "text": "から"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "(And) the days of nothing"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "罅が入ってそっから",
            "zh-CN": "裂开了一道缝隙 从那里",
            "segments": [
              {
                "text": "罅が入ってそっから",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "罅",
                    "reading": "ひび"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "入",
                    "reading": "はい"
                  },
                  {
                    "text": "ってそっから"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "get cracks"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "たくさんの「もしも」が漏れ出して",
            "zh-CN": "无数的「如果」泄露流淌",
            "segments": [
              {
                "text": "たくさんの「もしも」が漏れ出して",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "たくさんの「もしも」が"
                  },
                  {
                    "text": "漏",
                    "reading": "も"
                  },
                  {
                    "text": "れ"
                  },
                  {
                    "text": "出",
                    "reading": "だ"
                  },
                  {
                    "text": "して"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "and many \"if\"s are leaking"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "行くんだ。",
            "zh-CN": "蔓延开来。",
            "segments": [
              {
                "text": "行くんだ。",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "行",
                    "reading": "い"
                  },
                  {
                    "text": "くんだ。"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "from the cracks."
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "今目をつむって",
            "zh-CN": "此刻闭上双眸",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "今目をつむって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "今目",
                    "reading": "いまめ"
                  },
                  {
                    "text": "をつむって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Now I close my eyes,"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "耳をふさいで歩き出したよ",
            "zh-CN": "捂住耳朵迈步向前走去",
            "segments": [
              {
                "text": "耳をふさいで歩き出したよ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "耳",
                    "reading": "みみ"
                  },
                  {
                    "text": "をふさいで"
                  },
                  {
                    "text": "歩",
                    "reading": "ある"
                  },
                  {
                    "text": "き"
                  },
                  {
                    "text": "出",
                    "reading": "だ"
                  },
                  {
                    "text": "したよ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "my ears and start to walk forward."
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "君の声も君の笑顔も",
            "zh-CN": "你的声音也好 你的笑容也罢",
            "segments": [
              {
                "text": "君の声も君の笑顔も",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  },
                  {
                    "text": "も"
                  },
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "笑顔",
                    "reading": "えがお"
                  },
                  {
                    "text": "も"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I can't hear your voice"
          },
          {
            "id": "full-000012",
            "order": 11,
            "japanese": "見れないままだけどそれも良いかも。",
            "zh-CN": "虽然都无法再得见 但那样或许也不错。",
            "segments": [
              {
                "text": "見れないままだけどそれも良いかも。",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "見",
                    "reading": "み"
                  },
                  {
                    "text": "れないままだけどそれも"
                  },
                  {
                    "text": "良",
                    "reading": "い"
                  },
                  {
                    "text": "いかも。"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "and can't see your smiles, but it's fine."
          }
        ]
