              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "それ恥かかせてるわけなの？",
            "zh-CN": "这不是存心让我难堪嘛？",
            "segments": [
              {
                "text": "それ恥かかせてるわけなの？",
