                    "reading": "み"
                  },
                  {
                    "text": "つめちゃっていいのに"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "「え？　勘違い？」",
            "zh-CN": "「诶？想多了？」",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "「え？　勘違い？」",
