          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "僕の事　気にしてる？",
            "zh-CN": "你到底有没有 在意我？",
            "segments": [
              {
                "text": "僕の事　気にしてる？",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "事",
