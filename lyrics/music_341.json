            "trailingPerformerIds": []
          },
          {
            "id": "full-000014",
            "order": 13,
            "japanese": "鈍感男は嫌い　だって",
            "zh-CN": "最讨厌迟钝男了 毕竟",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "鈍感男は嫌い　だって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "鈍感男",
                    "reading": "どんかんおとこ"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "嫌",
                    "reading": "きら"
                  },
                  {
                    "text": "い　だって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000015",
            "order": 14,
            "japanese": "こんなにこんなにこんなにこんなに気づかない",
            "zh-CN": "竟然这么这么这么这么木讷毫无察觉",
