              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000013",
            "order": 12,
            "japanese": "これ以上からかうのはやめて！！",
            "zh-CN": "不要再继续捉弄我啦！！",
            "segments": [
              {
                "text": "これ以上からかうのはやめて！！",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "これ"
