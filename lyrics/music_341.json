                  },
                  {
                    "text": "　"
                  },
                  {
                    "text": "気",
                    "reading": "き"
                  },
                  {
                    "text": "にしてる？"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "ほらそんなに照れなくてもいいのに",
            "zh-CN": "哎呀明明不需要那么害羞的嘛",
            "segments": [
              {
                "text": "ほらそんなに照れなくてもいいのに",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ほらそんなに"
                  },
                  {
                    "text": "照",
                    "reading": "て"
                  },
                  {
                    "text": "れなくてもいいのに"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "もうちょっとだけ近づいちゃって",
            "zh-CN": "再稍微靠近一点点",
            "segments": [
              {
                "text": "もうちょっとだけ近づいちゃって",
