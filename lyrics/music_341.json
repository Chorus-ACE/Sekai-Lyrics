                "ruby": [
                  {
                    "text": "もうちょっとだけ"
                  },
                  {
                    "text": "近",
                    "reading": "ちか"
                  },
                  {
                    "text": "づいちゃって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "まじまじ見つめちゃっていいのに",
            "zh-CN": "目不转睛地注视着我也没关系哦",
            "segments": [
              {
                "text": "まじまじ見つめちゃっていいのに",
