                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Words flow from right to left"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "退屈そうな顔　画面見つめる君",
            "zh-CN": "满脸无聊凝视着屏幕的你",
