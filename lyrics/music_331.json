        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "「はじめまして」とか　何回言ったっけ",
            "zh-CN": "「初次见面」之类的话 说过多少遍了呢",
            "segments": [
              {
                "text": "「はじめまして」とか　何回言ったっけ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "「はじめまして」とか　"
                  },
                  {
                    "text": "何回言",
                    "reading": "なんかいい"
                  },
                  {
                    "text": "ったっけ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Just how many times have I said \"hello\"?"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "アタシ、ホントは人見知りで",
            "zh-CN": "我 其实是个认生害羞的人",
            "segments": [
              {
                "text": "アタシ、ホントは人見知りで",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "アタシ、ホントは"
                  },
                  {
                    "text": "人見知",
                    "reading": "ひとみし"
                  },
                  {
                    "text": "りで"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "To tell the truth, I'm pretty shy..."
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "ドキドキしてるよ　実は今だって",
            "zh-CN": "心脏扑通扑通跳个不停 其实就连现在也是",
            "segments": [
              {
                "text": "ドキドキしてるよ　実は今だって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ドキドキしてるよ　"
                  },
                  {
                    "text": "実",
                    "reading": "じつ"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "今",
                    "reading": "いま"
                  },
                  {
                    "text": "だって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "So my heart's pounding, actually - yes, even now;"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "上手く歌えてる？　ねえ怖いんだ今でも",
            "zh-CN": "有好好唱出来吗？ 呐 哪怕是现在我也好害怕",
            "segments": [
              {
                "text": "上手く歌えてる？　ねえ怖いんだ今でも",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "上手",
                    "reading": "うま"
                  },
                  {
                    "text": "く"
                  },
                  {
                    "text": "歌",
                    "reading": "うた"
                  },
                  {
                    "text": "えてる？　ねえ"
                  },
                  {
                    "text": "怖",
                    "reading": "こわ"
                  },
                  {
                    "text": "いんだ"
                  },
                  {
                    "text": "今",
                    "reading": "いま"
                  },
                  {
                    "text": "でも"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Am I singing well enough? It's scary, even to this day..."
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "それでも伝えたい",
            "zh-CN": "即便如此我也想传达给你",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "それでも伝えたい",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "それでも"
