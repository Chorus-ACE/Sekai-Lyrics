                "ruby": [
                  {
                    "text": "゛アタシ゛であって"
                  },
                  {
                    "text": "良",
                    "reading": "よ"
                  },
                  {
                    "text": "かったよ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "And I'm glad that \"me\" is who you all meet."
