                "ruby": [
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "出会",
                    "reading": "であ"
                  },
                  {
                    "text": "って　みんな"
                  },
                  {
                    "text": "出会",
                    "reading": "であ"
                  },
                  {
                    "text": "って"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I'm glad I met you, I'm glad I met everyone,"
          },
