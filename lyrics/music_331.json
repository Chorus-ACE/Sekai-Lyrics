              {
                "text": "逃げないんだ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "逃",
                    "reading": "に"
                  },
                  {
                    "text": "げないんだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I won't run away!"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "君に出会って　みんな出会って",
            "zh-CN": "与你相逢 与大家相逢",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "君に出会って　みんな出会って",
