                  {
                    "text": "伝",
                    "reading": "つた"
                  },
                  {
                    "text": "えたい"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "But still, I want to say this,"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "だからきっと頑張れるんだって",
            "zh-CN": "所以我一定能坚持努力下去",
            "segments": [
              {
                "text": "だからきっと頑張れるんだって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "だからきっと"
                  },
                  {
                    "text": "頑張",
                    "reading": "がんば"
                  },
                  {
                    "text": "れるんだって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "So I know I'll do a good job of it..."
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "逃げないんだ",
            "zh-CN": "绝不逃避",
