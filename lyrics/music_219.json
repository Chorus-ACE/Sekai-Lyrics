                    "reading": "のこ"
                  },
                  {
                    "text": "さないように"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "So you don't leave behind any regrets"
          },
          {
            "id": "full-000028",
            "order": 27,
            "japanese": "イェイ空を切るサンダーストーム",
            "zh-CN": "耶划破苍穹的狂暴雷霆 风暴肆虐",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "イェイ空を切るサンダーストーム",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "イェイ"
