                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Yeah, the sky's cleaved by a thunderstorm"
          },
          {
            "id": "full-000029",
            "order": 28,
            "japanese": "鳴動響かせてはバイバイバイ",
            "zh-CN": "鸣响回荡之后便挥手拜拜拜",
            "segments": [
              {
                "text": "鳴動響かせてはバイバイバイ",
