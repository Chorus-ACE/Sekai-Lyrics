                "ruby": [
                  {
                    "text": "鳴動響",
                    "reading": "めいどうひび"
                  },
                  {
                    "text": "かせてはバイバイバイ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "A rumble echoes, and it's bye-bye-bye"
          },
          {
            "id": "full-000030",
            "order": 29,
            "japanese": "もう少しだけ友達でいようぜ今回は",
            "zh-CN": "这次就再多做一会儿朋友吧",
            "segments": [
