                    "text": "どおりまでバイバイバイ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Which means until it's back to normal, bye-bye-bye"
          },
          {
            "id": "full-000026",
            "order": 25,
            "japanese": "思いついたら歩いていけ",
            "zh-CN": "只要想到就迈步向前走吧",
            "segments": [
              {
                "text": "思いついたら歩いていけ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "思",
                    "reading": "おも"
                  },
                  {
                    "text": "いついたら"
                  },
                  {
                    "text": "歩",
                    "reading": "ある"
                  },
                  {
                    "text": "いていけ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "If something comes to mind, then walk,"
          },
          {
            "id": "full-000027",
            "order": 26,
            "japanese": "心残り残さないように",
            "zh-CN": "为了不留下任何遗憾",
