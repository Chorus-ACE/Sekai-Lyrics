                    "reading": "ひげんじつ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Today, too, I'm sketching fantasies onto the night sky."
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "何もかも逃れようのない現実",
            "zh-CN": "一切皆无从逃避的残酷现实",
