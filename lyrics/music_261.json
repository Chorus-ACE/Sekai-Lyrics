        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "今日も夜空に浮かべた非現実の中",
            "zh-CN": "今天也在夜空中浮现的非现实之中",
            "segments": [
              {
                "text": "今日も夜空に浮かべた非現実の中",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "今日",
                    "reading": "きょう"
                  },
                  {
                    "text": "も"
                  },
                  {
                    "text": "夜空",
                    "reading": "よぞら"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "浮",
                    "reading": "う"
                  },
                  {
                    "text": "かべた"
                  },
                  {
                    "text": "非現実",
                    "reading": "ひげんじつ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "中",
                    "reading": "なか"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Today, too, I'm floating in the night sky, shrouded in fantasies,"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "真っ黒なキャンバスに星を描く",
            "zh-CN": "在漆黑的画布上描摹繁星",
            "segments": [
              {
                "text": "真っ黒なキャンバスに星を描く",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "真",
                    "reading": "ま"
                  },
                  {
                    "text": "っ"
                  },
                  {
                    "text": "黒",
                    "reading": "くろ"
                  },
                  {
                    "text": "なキャンバスに"
                  },
                  {
                    "text": "星",
                    "reading": "ほし"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "描",
                    "reading": "えが"
                  },
                  {
                    "text": "く"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "as I sketch more stars onto the pitch-black canvas."
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "静寂、巡る本能と縋るべき何か",
            "zh-CN": "静寂、循环流转的本能与理应依附之物",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "静寂、巡る本能と縋るべき何か",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "静寂",
                    "reading": "せいじゃく"
                  },
                  {
                    "text": "、"
                  },
                  {
                    "text": "巡",
                    "reading": "めぐ"
                  },
                  {
                    "text": "る"
                  },
                  {
                    "text": "本能",
                    "reading": "ほんのう"
                  },
                  {
                    "text": "と"
                  },
                  {
                    "text": "縋",
                    "reading": "すが"
                  },
                  {
                    "text": "るべき"
                  },
                  {
                    "text": "何",
                    "reading": "なに"
                  },
                  {
                    "text": "か"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Silence, returning instincts, something that I should rely on,"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "また響き渡る天使の叫び",
            "zh-CN": "再次响彻回荡天使的尖叫呐喊",
            "segments": [
              {
                "text": "また響き渡る天使の叫び",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "また"
                  },
                  {
                    "text": "響",
                    "reading": "ひび"
                  },
                  {
                    "text": "き"
                  },
                  {
                    "text": "渡",
                    "reading": "わた"
                  },
                  {
                    "text": "る"
                  },
                  {
                    "text": "天使",
                    "reading": "てんし"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "叫",
                    "reading": "さけ"
                  },
                  {
                    "text": "び"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "and once again an angel's yell echoing across from afar."
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "奏でる悲鳴は背徳の調べ",
            "zh-CN": "奏响的悲鸣乃是背德的曲调",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "奏でる悲鳴は背徳の調べ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "奏",
                    "reading": "かな"
                  },
                  {
                    "text": "でる"
                  },
                  {
                    "text": "悲鳴",
                    "reading": "ひめい"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "背徳",
                    "reading": "はいとく"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "調",
                    "reading": "しら"
                  },
                  {
                    "text": "べ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "That angelic shriek was a melody of corruption,"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "（儚く散りゆく世界で）",
            "zh-CN": "（在虚幻凋零散落的世界里）",
            "segments": [
              {
                "text": "（儚く散りゆく世界で）",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "（"
                  },
                  {
                    "text": "儚",
                    "reading": "はかな"
                  },
                  {
                    "text": "く"
                  },
                  {
                    "text": "散",
                    "reading": "ち"
                  },
                  {
                    "text": "りゆく"
                  },
                  {
                    "text": "世界",
                    "reading": "せかい"
                  },
                  {
                    "text": "で）"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "(in this transient, disintegrating world)"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "綺麗な星空を切り裂いて降らせた涙",
            "zh-CN": "撕裂美丽星空倾泻降下的泪水",
            "segments": [
              {
                "text": "綺麗な星空を切り裂いて降らせた涙",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "綺麗",
                    "reading": "きれい"
                  },
                  {
                    "text": "な"
                  },
                  {
                    "text": "星空",
                    "reading": "ほしぞら"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "切",
                    "reading": "き"
                  },
                  {
                    "text": "り"
                  },
                  {
                    "text": "裂",
                    "reading": "さ"
                  },
                  {
                    "text": "いて"
                  },
                  {
                    "text": "降",
                    "reading": "ふ"
                  },
                  {
                    "text": "らせた"
                  },
                  {
                    "text": "涙",
                    "reading": "なみだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "as it cleaved the grand starry sky and made me shed tears."
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "舞い踊る星屑眺めた夜は　まだ笑ってた",
            "zh-CN": "眺望翩翩起舞星屑的夜晚　曾经还在欢笑",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "舞い踊る星屑眺めた夜は　まだ笑ってた",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "舞",
                    "reading": "ま"
                  },
                  {
                    "text": "い"
                  },
                  {
                    "text": "踊",
                    "reading": "おど"
                  },
                  {
                    "text": "る"
                  },
                  {
                    "text": "星屑眺",
                    "reading": "ほしくずなが"
                  },
                  {
                    "text": "めた"
                  },
                  {
                    "text": "夜",
                    "reading": "よる"
                  },
                  {
                    "text": "は　まだ"
                  },
                  {
                    "text": "笑",
                    "reading": "わら"
                  },
                  {
                    "text": "ってた"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "On that night I was gazing at the dancing stardust,"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "泣いていた　生きている",
            "zh-CN": "曾经哭泣　依然活着",
            "segments": [
              {
                "text": "泣いていた　生きている",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "泣",
                    "reading": "な"
                  },
                  {
                    "text": "いていた　"
                  },
                  {
                    "text": "生",
                    "reading": "い"
                  },
                  {
                    "text": "きている"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "as I laughed, cried, and breathed."
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "今日もまた夜空に描いた非現実",
            "zh-CN": "今天也再次在夜空中描摹非现实",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "今日もまた夜空に描いた非現実",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "今日",
                    "reading": "きょう"
                  },
                  {
                    "text": "もまた"
                  },
                  {
                    "text": "夜空",
                    "reading": "よぞら"
                  },
                  {
                    "text": "に"
                  },
                  {
