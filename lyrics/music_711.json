        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "ふと旅に出たくなるように　ヒトは皆",
            "zh-CN": "就像突然想要启程旅行一般 人类皆是",
            "segments": [
              {
                "text": "ふと旅に出たくなるように　ヒトは皆",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ふと"
                  },
                  {
                    "text": "旅",
                    "reading": "たび"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "出",
                    "reading": "で"
                  },
                  {
                    "text": "たくなるように　ヒトは"
                  },
                  {
                    "text": "皆",
                    "reading": "みな"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "People all like to go out on an adventure all of a sudden"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "眠る場所を求めるものだと　君は云うけど",
            "zh-CN": "渴望寻得安眠之所 你虽是这般诉说",
            "segments": [
              {
                "text": "眠る場所を求めるものだと　君は云うけど",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "眠",
                    "reading": "ねむ"
                  },
                  {
                    "text": "る"
                  },
                  {
                    "text": "場所",
                    "reading": "ばしょ"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "求",
                    "reading": "もと"
                  },
                  {
                    "text": "めるものだと　"
                  },
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "云",
                    "reading": "い"
                  },
                  {
                    "text": "うけど"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "At the same time, you say that they also wish for a resting place"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "僕が\"終末\"を知ったときには　此処はもう",
            "zh-CN": "但当我知晓“终末”之时 这里早已",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "僕が\"終末\"を知ったときには　此処はもう",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "が\""
                  },
                  {
                    "text": "終末",
                    "reading": "しゅうまつ"
                  },
                  {
                    "text": "\"を"
                  },
                  {
                    "text": "知",
                    "reading": "し"
                  },
                  {
                    "text": "ったときには　"
                  },
                  {
                    "text": "此処",
                    "reading": "ここ"
                  },
                  {
                    "text": "はもう"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "When I found out that the \"end\" was near, this place was"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "暖かくも寒くもない速度で落ちていた",
            "zh-CN": "以不温亦不凉的速度 悄然坠落",
            "segments": [
              {
                "text": "暖かくも寒くもない速度で落ちていた",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "暖",
                    "reading": "あたた"
                  },
                  {
                    "text": "かくも"
                  },
                  {
                    "text": "寒",
                    "reading": "さむ"
                  },
                  {
                    "text": "くもない"
                  },
                  {
                    "text": "速度",
                    "reading": "そくど"
                  },
                  {
                    "text": "で"
                  },
                  {
                    "text": "落",
                    "reading": "お"
                  },
                  {
                    "text": "ちていた"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Falling without any warmth or coldness"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "『カミサマ』がもしも居たとしても",
            "zh-CN": "纵使「神明大人」真的存在",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "『カミサマ』がもしも居たとしても",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "『カミサマ』がもしも"
                  },
                  {
                    "text": "居",
                    "reading": "い"
                  },
                  {
                    "text": "たとしても"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Even if \"God\" existed"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "大きな空　溢れるほどの虹　かけてくれなくても良い",
            "zh-CN": "不在辽阔苍穹 架起满溢的彩虹也无妨",
            "segments": [
              {
                "text": "大きな空　溢れるほどの虹　かけてくれなくても良い",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "大",
                    "reading": "おお"
                  },
                  {
                    "text": "きな"
                  },
                  {
                    "text": "空",
                    "reading": "そら"
                  },
                  {
                    "text": "　"
                  },
                  {
                    "text": "溢",
                    "reading": "あふ"
                  },
                  {
                    "text": "れるほどの"
                  },
                  {
                    "text": "虹",
                    "reading": "にじ"
                  },
                  {
                    "text": "　かけてくれなくても"
                  },
                  {
                    "text": "良",
                    "reading": "い"
                  },
                  {
                    "text": "い"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I wouldn't want a rainbow covering the sky"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "『唯一つ　願いをかけるとしたら…？』",
            "zh-CN": "『若要许下 唯一的一个心愿……？』",
            "segments": [
              {
                "text": "『唯一つ　願いをかけるとしたら…？』",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "『"
                  },
                  {
                    "text": "唯一",
                    "reading": "ただひと"
                  },
                  {
                    "text": "つ　"
                  },
                  {
                    "text": "願",
                    "reading": "ねが"
                  },
                  {
                    "text": "いをかけるとしたら…？』"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "\"What is my one wish you ask...?\""
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "君のもとへ\"ウタ\"を届けたい",
            "zh-CN": "想将“歌声”传达到你的身边",
            "segments": [
              {
                "text": "君のもとへ\"ウタ\"を届けたい",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "のもとへ\"ウタ\"を"
                  },
                  {
                    "text": "届",
                    "reading": "とど"
                  },
                  {
                    "text": "けたい"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "That my \"song\" reaches you"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "メグル　メグル　最後の廻音",
            "zh-CN": "流转 轮回 最后的回响之音",
            "segments": [
              {
                "text": "メグル　メグル　最後の廻音",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "メグル　メグル　"
                  },
                  {
                    "text": "最後",
                    "reading": "さいご"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "廻音",
                    "reading": "めろでぃ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Spinning and spinning, my last melody"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "君が笑ってくれるのなら　僕は",
            "zh-CN": "只要你能为之绽放笑容 我哪怕",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "君が笑ってくれるのなら　僕は",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "笑",
                    "reading": "わら"
                  },
                  {
                    "text": "ってくれるのなら　"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "は"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "As long as you laugh by my side"
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "消えてしまっても　構わないから",
            "zh-CN": "就此烟消云散 也毫不在意",
            "segments": [
              {
                "text": "消えてしまっても　構わないから",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "消",
                    "reading": "き"
                  },
                  {
                    "text": "えてしまっても　"
                  },
                  {
                    "text": "構",
                    "reading": "かま"
                  },
                  {
                    "text": "わないから"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I don't care if I disappear"
          },
          {
            "id": "full-000012",
            "order": 11,
            "japanese": "白い嘘だらけの世界なんてもう",
            "zh-CN": "满是善意谎言的世界 哪怕",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "白い嘘だらけの世界なんてもう",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "白",
