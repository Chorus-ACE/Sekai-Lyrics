                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I locked up today, the future I see colored gray"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "望むなら空想　寂れた嘘",
