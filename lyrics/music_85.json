        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "君の声を聞かせて澱む心を祓って",
            "zh-CN": "让我听听你的声音 驱散这淤滞的心灵",
            "segments": [
              {
                "text": "君の声を聞かせて澱む心を祓って",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "聞",
                    "reading": "き"
                  },
                  {
                    "text": "かせて"
                  },
                  {
                    "text": "澱",
                    "reading": "よど"
                  },
                  {
                    "text": "む"
                  },
                  {
                    "text": "心",
                    "reading": "こころ"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "祓",
                    "reading": "はら"
                  },
                  {
                    "text": "って"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Let me hear your voice, purify this stagnant heart"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "偽りのキャンバスを　塗りつぶしてくんだ",
            "zh-CN": "将虚伪的画布 彻底涂抹掩盖",
            "segments": [
              {
                "text": "偽りのキャンバスを　塗りつぶしてくんだ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "偽",
                    "reading": "いつわ"
                  },
                  {
                    "text": "りのキャンバスを　"
                  },
                  {
                    "text": "塗",
                    "reading": "ぬ"
                  },
                  {
                    "text": "りつぶしてくんだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I'll paint over the canvas of lies"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "今日も",
            "zh-CN": "今天也是如此",
