                  },
                  {
                    "text": "も"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "today again"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "終末のない幻想に　触れた気がした",
            "zh-CN": "仿佛触碰到了那场永无止境的幻想",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "終末のない幻想に　触れた気がした",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "終末",
                    "reading": "しゅうまつ"
                  },
                  {
                    "text": "のない"
                  },
                  {
                    "text": "幻想",
                    "reading": "げんそう"
                  },
                  {
                    "text": "に　"
                  },
                  {
                    "text": "触",
                    "reading": "さわ"
                  },
                  {
                    "text": "れた"
                  },
                  {
                    "text": "気",
                    "reading": "き"
                  },
                  {
                    "text": "がした"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I felt like I was touched by an endless illusion"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "「なんて呼べばいいんだろう」　変わらない温度",
            "zh-CN": "“究竟该如何称呼才好呢” 恒久不变的温度",
            "segments": [
              {
                "text": "「なんて呼べばいいんだろう」　変わらない温度",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "「なんて"
                  },
                  {
                    "text": "呼",
                    "reading": "よ"
                  },
                  {
                    "text": "べばいいんだろう」　"
                  },
                  {
                    "text": "変",
                    "reading": "か"
                  },
                  {
                    "text": "わらない"
                  },
                  {
                    "text": "温度",
                    "reading": "おんど"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "\"What should I call it?\" The unchanging temperature"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "微笑が内臓を　食いつぶす前に",
            "zh-CN": "在微笑将内脏彻底吞噬殆尽之前",
            "segments": [
              {
                "text": "微笑が内臓を　食いつぶす前に",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "微笑",
                    "reading": "ほほえみ"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "内臓",
                    "reading": "ないぞう"
                  },
                  {
                    "text": "を　"
                  },
                  {
                    "text": "食",
                    "reading": "く"
                  },
                  {
                    "text": "いつぶす"
                  },
                  {
                    "text": "前",
                    "reading": "まえ"
                  },
                  {
                    "text": "に"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Before the smiles eat up at my insides"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "今日を閉じ込めたよ　馳せる未来は灰色",
            "zh-CN": "将今天封存了起来 驰骋而至的未来一片灰暗",
