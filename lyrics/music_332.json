                    "reading": "よる"
                  },
                  {
                    "text": "のストーリー"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "静けさがいつか見た夢を連れさらってく",
