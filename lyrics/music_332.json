          {
            "id": "full-000001",
            "order": 0,
            "japanese": "ひとりにはちょっと広過ぎて 眠れぬ夜のストーリー",
            "zh-CN": "独自一人显得有些过于宽敞 无法成眠之夜的故事",
            "segments": [
              {
                "text": "ひとりにはちょっと広過ぎて 眠れぬ夜のストーリー",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ひとりにはちょっと"
                  },
                  {
                    "text": "広",
                    "reading": "ひろ"
                  },
                  {
                    "text": "過",
                    "reading": "す"
                  },
                  {
                    "text": "ぎて "
                  },
                  {
