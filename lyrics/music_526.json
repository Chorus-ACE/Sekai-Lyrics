          {
            "id": "full-000001",
            "order": 0,
            "japanese": "旅に出て何度目かの惑星",
            "zh-CN": "踏上旅程后经历的不知第几个行星",
            "segments": [
              {
                "text": "旅に出て何度目かの惑星",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "旅",
                    "reading": "たび"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "出",
                    "reading": "で"
                  },
                  {
                    "text": "て"
                  },
                  {
                    "text": "何度目",
                    "reading": "なんどめ"
                  },
                  {
                    "text": "かの"
                  },
                  {
                    "text": "惑星",
                    "reading": "まち"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "明星がボクらの未知を照らした",
            "zh-CN": "启明星照亮了我们的未知前路",
