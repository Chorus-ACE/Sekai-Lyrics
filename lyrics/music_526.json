              {
                "text": "止めれる回答は見当たらない",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "止",
                    "reading": "と"
                  },
                  {
                    "text": "めれる"
                  },
                  {
                    "text": "回答",
