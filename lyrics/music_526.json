                "ruby": [
                  {
                    "text": "明星",
                    "reading": "みょうじょう"
                  },
                  {
                    "text": "がボクらの"
                  },
                  {
                    "text": "未知",
                    "reading": "みち"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "照",
                    "reading": "て"
                  },
                  {
                    "text": "らした"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "彗星銀河が迎える終末を",
            "zh-CN": "彗星银河即将迎来的终局",
            "segments": [
              {
                "text": "彗星銀河が迎える終末を",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "彗星銀河",
                    "reading": "すいせいぎんが"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "迎",
                    "reading": "むか"
                  },
                  {
                    "text": "える"
                  },
