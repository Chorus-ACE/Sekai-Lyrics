                    "reading": "しゅうまつ"
                  },
                  {
                    "text": "を"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "止めれる回答は見当たらない",
            "zh-CN": "却寻觅不到能够将其阻挡的答案",
