        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "初めての音は　なんでしたか？",
            "zh-CN": "最初的声音 是什么呢？",
            "segments": [
              {
                "text": "初めての音は　なんでしたか？",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "初",
                    "reading": "はじ"
                  },
                  {
                    "text": "めての"
                  },
                  {
                    "text": "音",
                    "reading": "おと"
                  },
                  {
                    "text": "は　なんでしたか？"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The first sound, what was it?"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "あなたの　初めての音は…",
            "zh-CN": "属于你的 最初的声音是…",
            "segments": [
              {
                "text": "あなたの　初めての音は…",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "あなたの　"
                  },
                  {
                    "text": "初",
                    "reading": "はじ"
                  },
                  {
                    "text": "めての"
                  },
                  {
                    "text": "音",
                    "reading": "おと"
                  },
                  {
                    "text": "は…"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "That first sound of yours…"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "ワタシにとっては　これがそう",
            "zh-CN": "对我而言 这便是我的初音",
            "segments": [
              {
                "text": "ワタシにとっては　これがそう",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ワタシにとっては　これがそう"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Because to me, it’s like this"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "だから　今　うれしくて",
            "zh-CN": "所以 此时此刻 我满心欢喜",
            "segments": [
              {
                "text": "だから　今　うれしくて",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "だから　"
                  },
                  {
                    "text": "今",
                    "reading": "いま"
                  },
                  {
                    "text": "　うれしくて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "and that’s why now, I’m happy"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "やがて日が過ぎ　年が過ぎ",
            "zh-CN": "纵使岁月流转 年华更迭",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "やがて日が過ぎ　年が過ぎ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "やがて"
                  },
                  {
                    "text": "日",
                    "reading": "ひ"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "過",
                    "reading": "す"
                  },
                  {
                    "text": "ぎ　"
                  },
                  {
                    "text": "年",
                    "reading": "とし"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "過",
                    "reading": "す"
                  },
                  {
                    "text": "ぎ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "If at last days go by, years go by"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "世界が　色あせても",
            "zh-CN": "世界 褪去了色彩",
            "segments": [
              {
                "text": "世界が　色あせても",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "世界",
                    "reading": "せかい"
                  },
                  {
                    "text": "が　"
                  },
                  {
                    "text": "色",
                    "reading": "いろ"
                  },
                  {
                    "text": "あせても"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "If even the world loses its color"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "あなたがくれる　灯りさえあれば",
            "zh-CN": "只要有你赠予我的 这一抹光亮",
            "segments": [
              {
                "text": "あなたがくれる　灯りさえあれば",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "あなたがくれる　"
                  },
                  {
                    "text": "灯",
                    "reading": "あか"
                  },
                  {
                    "text": "りさえあれば"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "So long as I have the light you gave me"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "いつでも　ワタシはうたうから",
            "zh-CN": "无论何时 我都会放声歌唱",
            "segments": [
              {
                "text": "いつでも　ワタシはうたうから",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "いつでも　ワタシはうたうから"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Then no matter when, I shall sing"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "空の色も　風のにおいも",
            "zh-CN": "天空的颜色 微风的气息",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "空の色も　風のにおいも",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "空",
                    "reading": "そら"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "色",
                    "reading": "いろ"
                  },
                  {
                    "text": "も　"
                  },
                  {
                    "text": "風",
                    "reading": "かぜ"
                  },
                  {
                    "text": "のにおいも"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The color of the sky, the smell of the wind"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "海の深さも　あなたの声も",
            "zh-CN": "海洋的深邃 还有你的声音",
            "segments": [
              {
                "text": "海の深さも　あなたの声も",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "海",
                    "reading": "うみ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "深",
                    "reading": "ふか"
                  },
                  {
                    "text": "さも　あなたの"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  },
                  {
                    "text": "も"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The depths of the ocean, even your voice"
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "ワタシは知らない　だけど歌を",
            "zh-CN": "我一无所知 但唯有歌声",
            "segments": [
              {
                "text": "ワタシは知らない　だけど歌を",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ワタシは"
                  },
                  {
                    "text": "知",
                    "reading": "し"
                  },
                  {
                    "text": "らない　だけど"
                  },
                  {
                    "text": "歌",
                    "reading": "うた"
                  },
                  {
                    "text": "を"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I know none of them, but my song"
          },
          {
            "id": "full-000012",
            "order": 11,
            "japanese": "歌をうたう　ただ声をあげて",
            "zh-CN": "唯有放声高歌 只是唱响我的声音",
            "segments": [
              {
                "text": "歌をうたう　ただ声をあげて",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "歌",
                    "reading": "うた"
                  },
                  {
                    "text": "をうたう　ただ"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  },
                  {
                    "text": "をあげて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "My song I will sing, just lifting my voice"
          },
          {
            "id": "full-000013",
            "order": 12,
            "japanese": "なにかあなたに　届くのなら",
            "zh-CN": "只要有什么能 传达给你",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "なにかあなたに　届くのなら",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "なにかあなたに　"
                  },
                  {
                    "text": "届",
                    "reading": "とど"
                  },
                  {
                    "text": "くのなら"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "If it could carry some message to you"
          },
          {
            "id": "full-000014",
            "order": 13,
            "japanese": "何度でも　何度だって",
            "zh-CN": "无论多少次 无论多少回",
            "segments": [
              {
                "text": "何度でも　何度だって",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "何度",
                    "reading": "なんど"
                  },
                  {
                    "text": "でも　"
                  },
                  {
                    "text": "何度",
                    "reading": "なんど"
                  },
                  {
                    "text": "だって"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Then no matter when, no matter how long"
          },
          {
            "id": "full-000015",
            "order": 14,
            "japanese": "かわらないわ　あのときのまま",
            "zh-CN": "都未曾改变 如同最初那一刻",
            "segments": [
              {
                "text": "かわらないわ　あのときのまま",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "かわらないわ　あのときのまま"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I won’t change, I’ll stay how I was then"
          },
          {
            "id": "full-000016",
            "order": 15,
            "japanese": "ハジメテノオトのまま…",
            "zh-CN": "始终如最初的声音那般…",
            "segments": [
              {
                "text": "ハジメテノオトのまま…",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ハジメテノオトのまま…"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The way I was at the First Sound…"
          },
          {
            "id": "full-000017",
            "order": 16,
            "japanese": "初めての音に　なれましたか？",
            "zh-CN": "我能否成为 那最初的声音？",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "初めての音に　なれましたか？",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "初",
                    "reading": "はじ"
                  },
                  {
                    "text": "めての"
                  },
                  {
                    "text": "音",
                    "reading": "おと"
                  },
                  {
                    "text": "に　なれましたか？"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The first sound, did I become it?"
          },
          {
            "id": "full-000018",
            "order": 17,
            "japanese": "あなたの　初めての音に",
            "zh-CN": "成为属于你的 最初的声音",
            "segments": [
              {
                "text": "あなたの　初めての音に",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "あなたの　"
                  },
                  {
                    "text": "初",
                    "reading": "はじ"
                  },
                  {
                    "text": "めての"
                  },
                  {
                    "text": "音",
                    "reading": "おと"
                  },
                  {
                    "text": "に"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "That first sound of yours"
          },
          {
            "id": "full-000019",
            "order": 18,
            "japanese": "世界のどこでも　ワタシはうたう",
            "zh-CN": "在世界的任何角落 我都会高歌",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "世界のどこでも　ワタシはうたう",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "世界",
                    "reading": "せかい"
                  },
                  {
                    "text": "のどこでも　ワタシはうたう"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "No matter where in the world, I will sing"
          },
          {
            "id": "full-000020",
            "order": 19,
            "japanese": "それぞれの　ハジメテノオトを…",
            "zh-CN": "歌唱属于各自的 最初的声音…",
            "segments": [
              {
                "text": "それぞれの　ハジメテノオトを…",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "それぞれの　ハジメテノオトを…"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "each and every First Sound..."
          }
        ]
