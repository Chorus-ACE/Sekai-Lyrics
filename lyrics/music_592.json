                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "zh-CN": "反正无论怎样挣扎也是徒劳"
          },
          {
            "id": "line-6",
            "order": 5,
            "japanese": "死ぬまで還れない",
            "segments": [
              {
                "text": "死ぬまで還れない",
                "performerIds": [
                  "歌唱者-24"
