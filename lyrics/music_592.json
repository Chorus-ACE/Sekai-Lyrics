                    "text": "まるで"
                  },
                  {
                    "text": "処女",
                    "reading": "しょじょ"
                  },
                  {
                    "text": "のように――"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "zh-CN": "简直如同纯洁处女一般——"
          },
          {
