                    "reading": "かえ"
                  },
                  {
                    "text": "れない"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "zh-CN": "直到死前都无法返回"
          },
          {
            "id": "line-7",
            "order": 6,
            "japanese": "不気味な猫が黒の中で嗤う",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "不気味な猫が黒の中で嗤う",
                "performerIds": [
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "不気味",
                    "reading": "ぶきみ"
                  },
                  {
                    "text": "な"
                  },
                  {
                    "text": "猫",
                    "reading": "ねこ"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "黒",
