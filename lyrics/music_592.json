                "ruby": [
                  {
                    "text": "How are you doing, Miss?"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "zh-CN": "How are you doing, Miss?"
          },
          {
            "id": "line-4",
            "order": 3,
            "japanese": "But you're tempted by the moonlight",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "But you're tempted by the moonlight",
                "performerIds": [
