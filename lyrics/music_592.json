                "ruby": [
                  {
                    "text": "「こんなにも"
                  },
                  {
                    "text": "濡",
                    "reading": "ぬ"
                  },
                  {
                    "text": "れてるじゃアないか」"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "zh-CN": "「这不是早已湿透得不成样子了吗」"
          },
          {
            "id": "line-9",
            "order": 8,
            "japanese": "官能へ響く嬌声にそっと耳を欹て",
            "segments": [
              {
                "text": "官能へ響く嬌声にそっと耳を欹て",
                "performerIds": [
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "官能",
                    "reading": "かんのう"
                  },
                  {
                    "text": "へ"
                  },
                  {
                    "text": "響",
                    "reading": "ひび"
                  },
                  {
                    "text": "く"
                  },
                  {
                    "text": "嬌声",
                    "reading": "きょうせい"
                  },
                  {
                    "text": "にそっと"
                  },
                  {
                    "text": "耳",
                    "reading": "みみ"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "欹",
                    "reading": "そばだ"
                  },
                  {
                    "text": "て"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "zh-CN": "悄然侧耳倾听那响彻感官深处的娇喘"
          },
          {
            "id": "line-10",
            "order": 9,
            "japanese": "まるで処女のように――",
            "segments": [
