          },
          {
            "id": "line-2",
            "order": 1,
            "japanese": "ここでは誰モが淫猥ら",
            "segments": [
              {
                "text": "ここでは誰モが淫猥ら",
                "performerIds": [
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "ここでは"
                  },
                  {
                    "text": "誰",
