            "zh-CN": "诡异莫测的猫咪在漆黑之中嗤笑"
          },
          {
            "id": "line-8",
            "order": 7,
            "japanese": "「こんなにも濡れてるじゃアないか」",
            "segments": [
              {
                "text": "「こんなにも濡れてるじゃアないか」",
                "performerIds": [
                  "歌唱者-24"
