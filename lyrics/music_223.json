        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "ひとり灰色の丘　乾いた枯草踏みしめて",
            "zh-CN": "孤身一人伫立在灰色的丘陵 踏碎干涸枯萎的荒草",
            "segments": [
              {
                "text": "ひとり灰色の丘　乾いた枯草踏みしめて",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ひとり"
                  },
                  {
                    "text": "灰色",
                    "reading": "はいいろ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "丘",
                    "reading": "おか"
                  },
                  {
