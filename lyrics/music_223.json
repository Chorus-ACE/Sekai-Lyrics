                  },
                  {
                    "text": "乾",
                    "reading": "かわ"
                  },
                  {
                    "text": "いた"
                  },
                  {
                    "text": "枯草踏",
                    "reading": "かれくさふ"
                  },
                  {
                    "text": "みしめて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Alone on a grey hill, stepping on the withered grass"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "思い巡らせる　空の彼方に",
            "zh-CN": "思绪翻涌飞扬 飘向苍穹的彼方",
