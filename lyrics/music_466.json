      "full": {
        "version": {
          "kind": "vocaloid",
          "label": "VIRTUAL SINGER Version"
        },
        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "青く澄んだ雨の病",
            "zh-CN": "澄澈碧蓝的雨之顽疾",
            "segments": [
              {
                "text": "青く澄んだ雨の病",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "青",
                    "reading": "あお"
                  },
                  {
                    "text": "く"
                  },
                  {
                    "text": "澄",
                    "reading": "す"
                  },
                  {
                    "text": "んだ"
                  },
                  {
                    "text": "雨",
                    "reading": "あめ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "病",
                    "reading": "やまい"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Disease of a clear-blue rain."
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "一人きりの呼吸は徒然",
            "zh-CN": "孤身一人的呼吸百无聊赖",
            "segments": [
              {
                "text": "一人きりの呼吸は徒然",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "一人",
                    "reading": "ひとり"
                  },
                  {
                    "text": "きりの"
                  },
                  {
                    "text": "呼吸",
                    "reading": "こきゅう"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "徒然",
                    "reading": "つれずれ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "All alone, I breathe leisurely."
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "痛む心に滲む鋼鉄の愛があった",
            "zh-CN": "作痛的心底渗出钢铁般的爱意",
            "segments": [
              {
                "text": "痛む心に滲む鋼鉄の愛があった",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "痛",
                    "reading": "いた"
                  },
                  {
                    "text": "む"
                  },
                  {
                    "text": "心",
                    "reading": "こころ"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "滲",
                    "reading": "にじ"
                  },
                  {
                    "text": "む"
                  },
                  {
                    "text": "鋼鉄",
                    "reading": "こうてつ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "愛",
                    "reading": "あい"
                  },
                  {
                    "text": "があった"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Within my sore heart was this steel love spreading."
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "触れたならば消えてしまう",
            "zh-CN": "一旦触碰便会消散",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "触れたならば消えてしまう",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "触",
                    "reading": "ふ"
                  },
                  {
                    "text": "れたならば"
                  },
                  {
                    "text": "消",
                    "reading": "き"
                  },
                  {
                    "text": "えてしまう"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "“Just like a dimly burning flame"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "微かに灯る炎のように",
            "zh-CN": "宛如微弱摇曳的火苗一般",
            "segments": [
              {
                "text": "微かに灯る炎のように",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "微",
                    "reading": "かす"
                  },
                  {
                    "text": "かに"
                  },
                  {
                    "text": "灯",
                    "reading": "とも"
                  },
                  {
                    "text": "る"
                  },
                  {
                    "text": "炎",
                    "reading": "ほのお"
                  },
                  {
                    "text": "のように"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "That would die out when touched,"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "全てを知らないままでいたいと君は言う",
            "zh-CN": "“希望能一直对一切一无所知”你这般说道",
            "segments": [
              {
                "text": "全てを知らないままでいたいと君は言う",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "全",
                    "reading": "すべ"
                  },
                  {
                    "text": "てを"
                  },
                  {
                    "text": "知",
                    "reading": "し"
                  },
                  {
                    "text": "らないままでいたいと"
                  },
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "言",
                    "reading": "い"
                  },
                  {
                    "text": "う"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I wish to be ignorant of everything,” you say."
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "瞳は僕を捉え",
            "zh-CN": "视线捕捉到我的身影",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "瞳は僕を捉え",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "瞳",
                    "reading": "ひとみ"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "捉",
                    "reading": "とら"
                  },
                  {
                    "text": "え"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Your eyes are focusing on me"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "確かにそこにいるのに",
            "zh-CN": "明明真切地伫立在此处",
            "segments": [
              {
                "text": "確かにそこにいるのに",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "確",
                    "reading": "たし"
                  },
                  {
                    "text": "かにそこにいるのに"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "And I certainly am there—"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "映すのに",
            "zh-CN": "明明清晰倒映其中",
            "segments": [
              {
                "text": "映すのに",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "映",
                    "reading": "うつ"
                  },
                  {
                    "text": "すのに"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I should be reflected there,"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "どこか虚ろに空を見る",
            "zh-CN": "却又不知为何空洞地望向天空",
            "segments": [
              {
                "text": "どこか虚ろに空を見る",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "どこか"
                  },
                  {
                    "text": "虚",
                    "reading": "うつ"
                  },
                  {
                    "text": "ろに"
                  },
                  {
                    "text": "空",
                    "reading": "くう"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "見",
                    "reading": "み"
                  },
                  {
                    "text": "る"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "But you look into space, somewhat vacantly."
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "伝えたい言葉は鋭利",
            "zh-CN": "想要传达的话语尖锐锋利",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "伝えたい言葉は鋭利",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "伝",
                    "reading": "つた"
                  },
                  {
                    "text": "えたい"
                  },
                  {
                    "text": "言葉",
                    "reading": "ことば"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "鋭利",
                    "reading": "えいり"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The words I want to convey are so sharp."
          },
          {
            "id": "full-000012",
            "order": 11,
            "japanese": "それでも僕は",
            "zh-CN": "纵然如此 我依然是",
            "segments": [
              {
                "text": "それでも僕は",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "それでも"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "は"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "But since I, nevertheless,"
          },
          {
            "id": "full-000013",
            "order": 12,
            "japanese": "こんな人間だ",
            "zh-CN": "这样一个凡人",
            "segments": [
              {
                "text": "こんな人間だ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "こんな"
                  },
                  {
                    "text": "人間",
                    "reading": "にんげん"
                  },
                  {
                    "text": "だ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Am a person like this,"
          },
          {
            "id": "full-000014",
            "order": 13,
            "japanese": "証明をここに残す",
            "zh-CN": "在此留下证明",
            "segments": [
              {
                "text": "証明をここに残す",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "証明",
                    "reading": "しょうめい"
                  },
                  {
                    "text": "をここに"
                  },
                  {
                    "text": "残",
                    "reading": "のこ"
                  },
                  {
                    "text": "す"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I will just leave my proof here—"
          },
          {
            "id": "full-000015",
            "order": 14,
            "japanese": "「愛している、君だけを。」",
            "zh-CN": "“我爱着你，唯独深爱你一人。”",
            "segments": [
              {
                "text": "「愛している、君だけを。」",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "「"
                  },
                  {
                    "text": "愛",
                    "reading": "あい"
                  },
                  {
                    "text": "している、"
                  },
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "だけを。」"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "“I love you, you only.”"
          },
          {
            "id": "full-000016",
            "order": 15,
            "japanese": "深い眠りの奥いつか",
            "zh-CN": "在深沉沉睡的深处 某一天",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "深い眠りの奥いつか",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "深",
                    "reading": "ふか"
                  },
                  {
                    "text": "い"
                  },
                  {
                    "text": "眠",
                    "reading": "ねむ"
                  },
                  {
                    "text": "りの"
                  },
                  {
                    "text": "奥",
                    "reading": "おく"
                  },
                  {
                    "text": "いつか"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "In the depths of a sound sleep, I will"
          },
          {
            "id": "full-000017",
            "order": 16,
            "japanese": "鼓動を確かめて",
            "zh-CN": "确认着心跳的脉动",
            "segments": [
              {
                "text": "鼓動を確かめて",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "鼓動",
                    "reading": "こどう"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "確",
                    "reading": "たし"
                  },
                  {
                    "text": "かめて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Someday ascertain if my heart’s pulsating—"
          },
          {
            "id": "full-000018",
            "order": 17,
            "japanese": "全て夢だった",
            "zh-CN": "一切全都是梦境",
            "segments": [
              {
                "text": "全て夢だった",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "全",
                    "reading": "すべ"
                  },
                  {
                    "text": "て"
                  },
                  {
                    "text": "夢",
                    "reading": "ゆめ"
                  },
                  {
                    "text": "だった"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Everything was just a dream."
          },
          {
            "id": "full-000019",
            "order": 18,
            "japanese": "そして混沌は",
            "zh-CN": "于是混沌",
            "segments": [
              {
                "text": "そして混沌は",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "そして"
                  },
                  {
                    "text": "混沌",
                    "reading": "こんとん"
                  },
                  {
                    "text": "は"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "And the chaos"
          },
          {
            "id": "full-000020",
            "order": 19,
            "japanese": "また花開く、と歩き出す",
            "zh-CN": "再次绽放花朵，迈开步伐",
            "segments": [
              {
                "text": "また花開く、と歩き出す",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "また"
                  },
                  {
                    "text": "花開",
                    "reading": "はなひら"
                  },
                  {
                    "text": "く、と"
                  },
                  {
                    "text": "歩",
                    "reading": "ある"
                  },
                  {
                    "text": "き"
                  },
                  {
                    "text": "出",
                    "reading": "だ"
                  },
                  {
                    "text": "す"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Will set off on foot, foretelling another efflorescence."
          },
          {
            "id": "full-000021",
            "order": 20,
            "japanese": "眩んだ視界の先十のうち",
            "zh-CN": "在模糊眩晕的视野前方 仅存一分",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "眩んだ視界の先十のうち",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "眩",
                    "reading": "くら"
                  },
                  {
                    "text": "んだ"
                  },
                  {
                    "text": "視界",
                    "reading": "しかい"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "先十",
                    "reading": "さきとお"
                  },
                  {
                    "text": "のうち"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Beyond my faint sight, out of ten,"
          },
          {
            "id": "full-000022",
            "order": 21,
            "japanese": "君はもう遠く",
            "zh-CN": "你却已然远去",
            "segments": [
              {
                "text": "君はもう遠く",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "はもう"
                  },
                  {
                    "text": "遠",
                    "reading": "とお"
                  },
                  {
                    "text": "く"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "You’ve already gone quite far away,"
          },
          {
            "id": "full-000023",
            "order": 22,
            "japanese": "薄い透明のベールをひらり纏い",
            "zh-CN": "轻盈披上一层薄薄的透明面纱",
            "segments": [
              {
                "text": "薄い透明のベールをひらり纏い",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "薄",
                    "reading": "うす"
                  },
                  {
                    "text": "い"
                  },
                  {
                    "text": "透明",
                    "reading": "とうめい"
                  },
                  {
                    "text": "のベールをひらり"
                  },
                  {
                    "text": "纏",
                    "reading": "まと"
                  },
                  {
                    "text": "い"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Clad in a thin, transparent veil,"
          },
          {
            "id": "full-000024",
            "order": 23,
            "japanese": "闇を飾っていく",
            "zh-CN": "装点起无尽的黑暗",
            "segments": [
              {
                "text": "闇を飾っていく",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "闇",
                    "reading": "やみ"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "飾",
                    "reading": "かざ"
                  },
                  {
                    "text": "っていく"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Decorating the darkness."
          }
        ]
      },
