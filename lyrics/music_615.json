                    "reading": "たんじょうび"
                  },
                  {
                    "text": "ですね"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "僕の生まれた街が白い雪のキャンバスに変わる",
            "zh-CN": "我所降生的街市化作了白雪皑皑的画卷画布",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "僕の生まれた街が白い雪のキャンバスに変わる",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "の"
