                  {
                    "text": "が"
                  },
                  {
                    "text": "白",
                    "reading": "しろ"
                  },
                  {
                    "text": "い"
                  },
                  {
                    "text": "雪",
                    "reading": "ゆき"
                  },
                  {
                    "text": "のキャンバスに"
                  },
                  {
                    "text": "変",
                    "reading": "か"
                  },
                  {
                    "text": "わる"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "ちょっと汚したくもなるのは子供みたいですか？",
            "zh-CN": "想要在上面稍微踩脏弄乱是不是显得太像小孩子了？",
            "segments": [
              {
                "text": "ちょっと汚したくもなるのは子供みたいですか？",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ちょっと"
                  },
                  {
                    "text": "汚",
                    "reading": "よご"
                  },
                  {
                    "text": "したくもなるのは"
                  },
                  {
                    "text": "子供",
                    "reading": "こども"
                  },
                  {
                    "text": "みたいですか？"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "ああそうだ、じゃあ",
            "zh-CN": "啊啊正是如此 既然这样",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "ああそうだ、じゃあ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ああそうだ、じゃあ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "お気に入りの服を着て君を迎えにいこう",
            "zh-CN": "就穿上心爱的衣裳前去迎接你吧",
            "segments": [
              {
