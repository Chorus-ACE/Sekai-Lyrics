            "trailingPerformerIds": []
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "ほらハッピーバースデー",
            "zh-CN": "瞧 祝你生日快乐",
            "segments": [
              {
                "text": "ほらハッピーバースデー",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ほらハッピーバースデー"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "毎日が誰かの誕生日ですね",
            "zh-CN": "每一天都是某个人的诞生日呢",
            "segments": [
              {
                "text": "毎日が誰かの誕生日ですね",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "毎日",
                    "reading": "まいにち"
                  },
                  {
                    "text": "が"
                  },
                  {
