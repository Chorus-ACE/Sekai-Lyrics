                "ruby": [
                  {
                    "text": "ピピピピ　とくにいじょうないようだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Peep, peep, nothing seems to be wrong"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "ポストのなかは　きっとカラッポだ",
            "zh-CN": "邮箱里面 一定空空如也",
