              {
                "text": "シェルターのおと　ひとりめがさめた",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "シェルターのおと　ひとりめがさめた"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The Shelter alarmed and I woke up alone"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "ピピピピ　とくにいじょうないようだ",
            "zh-CN": "哔哔哔哔 似乎并无异常",
