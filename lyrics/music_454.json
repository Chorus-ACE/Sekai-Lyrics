                  {
                    "text": "その"
                  },
                  {
                    "text": "日",
                    "reading": "ひ"
                  },
                  {
                    "text": "からワタシのココロの"
                  },
                  {
                    "text": "中",
                    "reading": "なか"
                  },
                  {
                    "text": "、"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "アナタで満たされてるの",
            "zh-CN": "就已被你全数填满",
