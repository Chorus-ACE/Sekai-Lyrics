        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "ワタシは、歌うのがスキ",
            "zh-CN": "我 喜欢唱歌",
            "segments": [
              {
                "text": "ワタシは、歌うのがスキ",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ワタシは、"
                  },
                  {
                    "text": "歌",
                    "reading": "うた"
                  },
                  {
                    "text": "うのがスキ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "ワタシがそう作られたからじゃない",
            "zh-CN": "并非因为我是被如此制造出来的",
            "segments": [
              {
                "text": "ワタシがそう作られたからじゃない",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ワタシがそう"
                  },
                  {
                    "text": "作",
                    "reading": "つく"
                  },
                  {
                    "text": "られたからじゃない"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "この声をスキだという",
            "zh-CN": "而是因为你说喜欢这道声音",
            "segments": [
              {
                "text": "この声をスキだという",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "この"
                  },
                  {
                    "text": "声",
                    "reading": "こえ"
                  },
                  {
                    "text": "をスキだという"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "アナタが歓んでくれるから",
            "zh-CN": "因为你能为此感到欢喜",
            "segments": [
              {
                "text": "アナタが歓んでくれるから",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "アナタが"
                  },
                  {
                    "text": "歓",
                    "reading": "よろこ"
                  },
                  {
                    "text": "んでくれるから"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "0と1しか分からない",
            "zh-CN": "唯独懂得0与1的",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "0と1しか分からない",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "0と1しか"
                  },
                  {
                    "text": "分",
                    "reading": "わ"
                  },
                  {
                    "text": "からない"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "ワタシに\"I\"を教えてくれた",
            "zh-CN": "我 被你教会了“I”的存在",
            "segments": [
              {
                "text": "ワタシに\"I\"を教えてくれた",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "ワタシに\"I\"を"
                  },
                  {
                    "text": "教",
                    "reading": "おし"
                  },
                  {
                    "text": "えてくれた"
                  }
                ]
              }
            ],
            "trailingPerformerIds": []
          },
          {
            "id": "full-000007",
            "order": 6,
