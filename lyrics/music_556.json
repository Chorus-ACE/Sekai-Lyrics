                  {
                    "text": "りが　"
                  },
                  {
                    "text": "届",
                    "reading": "とど"
                  },
                  {
                    "text": "けばいいなぁ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I can only hope this song and prayer come through"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "雲ひとつないような　抜けるほど晴天の今日は",
            "zh-CN": "万里无云 通透澄澈的晴空之下",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "雲ひとつないような　抜けるほど晴天の今日は",
                "performerIds": [
                  "歌唱者-18",
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "雲",
