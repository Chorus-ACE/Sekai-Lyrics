                    "reading": "きょう"
                  },
                  {
                    "text": "は"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "A sunny day such as today, like there's not a cloud in the sky,"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "悲しいくらいに　お別れ日和で",
            "zh-CN": "今日竟是令人悲伤的 绝佳诀别之日",
            "segments": [
              {
                "text": "悲しいくらいに　お別れ日和で",
                "performerIds": [
                  "歌唱者-20",
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "悲",
                    "reading": "かな"
                  },
                  {
                    "text": "しいくらいに　お"
                  },
                  {
                    "text": "別",
                    "reading": "わか"
                  },
                  {
                    "text": "れ"
                  },
                  {
                    "text": "日和",
                    "reading": "びより"
                  },
                  {
                    "text": "で"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Is such perfect weather for parting that it's sad"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "ありふれた人生を　紅く色付ける様な",
            "zh-CN": "宛如为平淡无奇的人生 染上一抹嫣红",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "ありふれた人生を　紅く色付ける様な",
                "performerIds": [
                  "歌唱者-19",
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "ありふれた"
