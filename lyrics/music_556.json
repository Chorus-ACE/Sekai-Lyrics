        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "むこうはどんな所なんだろうね？",
            "zh-CN": "那边会是怎样的一处地方呢？",
            "segments": [
              {
                "text": "むこうはどんな所なんだろうね？",
                "performerIds": [
                  "歌唱者-19"
                ],
                "ruby": [
                  {
                    "text": "むこうはどんな"
                  },
                  {
                    "text": "所",
                    "reading": "ところ"
                  },
                  {
                    "text": "なんだろうね？"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "What is it like over there?"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "無事に着いたら　便りでも欲しいよ",
            "zh-CN": "若是平安抵达 希望能收到你的只言片语啊",
            "segments": [
              {
                "text": "無事に着いたら　便りでも欲しいよ",
                "performerIds": [
                  "歌唱者-20"
                ],
                "ruby": [
                  {
                    "text": "無事",
                    "reading": "ぶじ"
                  },
                  {
                    "text": "に"
                  },
                  {
                    "text": "着",
                    "reading": "つ"
                  },
                  {
                    "text": "いたら　"
                  },
                  {
                    "text": "便",
                    "reading": "たよ"
                  },
                  {
                    "text": "りでも"
                  },
                  {
                    "text": "欲",
                    "reading": "ほ"
                  },
                  {
                    "text": "しいよ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I'd like to hear from you, if you arrived safely"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "扉を開いて　彼方へと向かうあなたへ",
            "zh-CN": "献给推开门扉 启程奔赴彼方的你",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "扉を開いて　彼方へと向かうあなたへ",
                "performerIds": [
                  "歌唱者-18"
                ],
                "ruby": [
                  {
                    "text": "扉",
