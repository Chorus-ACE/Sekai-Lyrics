                    "reading": "む"
                  },
                  {
                    "text": "かうあなたへ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "To you, who is opening the door and heading that way,"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "この歌声と祈りが　届けばいいなぁ",
            "zh-CN": "若这份歌声与祈愿 能够传达给你就好了啊",
            "segments": [
              {
                "text": "この歌声と祈りが　届けばいいなぁ",
                "performerIds": [
                  "歌唱者-17"
                ],
                "ruby": [
                  {
                    "text": "この"
                  },
                  {
                    "text": "歌声",
                    "reading": "うたごえ"
                  },
                  {
                    "text": "と"
