          {
            "id": "full-000011",
            "order": 10,
            "japanese": "言葉で世界が変わる時は訪れないけど",
            "zh-CN": "凭借言语改变世界的时刻虽不会到来",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "言葉で世界が変わる時は訪れないけど",
                "performerIds": [],
                "ruby": [
                  {
                    "text": "言葉",
                    "reading": "ことば"
                  },
                  {
