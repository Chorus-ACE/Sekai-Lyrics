        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "見つめ合う　その視線　閉じた世界の中",
            "zh-CN": "彼此凝视的 那道视线 在封闭的世界之中",
            "segments": [
              {
                "text": "見つめ合う　その視線　閉じた世界の中",
                "performerIds": [
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "見",
                    "reading": "み"
                  },
                  {
                    "text": "つめ"
                  },
                  {
                    "text": "合",
                    "reading": "あ"
                  },
                  {
                    "text": "う　その"
                  },
                  {
                    "text": "視線",
                    "reading": "しせん"
                  },
                  {
                    "text": "　"
                  },
                  {
                    "text": "閉",
                    "reading": "と"
                  },
                  {
                    "text": "じた"
                  },
                  {
                    "text": "世界",
                    "reading": "せかい"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "中",
                    "reading": "なか"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Our gazes meet, inside this closed-off world"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "気づかない　ふりをしても　酔いを悟られそう",
            "zh-CN": "就算装作 毫无察觉 也快被看穿醉意",
            "segments": [
              {
                "text": "気づかない　ふりをしても　酔いを悟られそう",
                "performerIds": [
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "気",
                    "reading": "き"
                  },
                  {
                    "text": "づかない　ふりをしても　"
                  },
                  {
                    "text": "酔",
                    "reading": "よ"
                  },
                  {
                    "text": "いを"
                  },
                  {
                    "text": "悟",
                    "reading": "さと"
                  },
                  {
                    "text": "られそう"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "You may pretend not to notice, but we're drunk on love"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "焼け付くこの心　隠して近づいて",
            "zh-CN": "隐藏起如烈火灼烧的这颗心 悄然靠近",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "焼け付く",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "焼",
                    "reading": "や"
                  },
                  {
                    "text": "け"
                  },
                  {
                    "text": "付",
                    "reading": "つ"
                  },
                  {
                    "text": "く"
                  }
                ]
              },
              {
                "text": "この心　",
                "performerIds": [
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "この"
                  },
                  {
                    "text": "心",
                    "reading": "こころ"
                  },
                  {
                    "text": "　"
                  }
                ]
              },
              {
                "text": "隠して",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "隠",
                    "reading": "かく"
                  },
                  {
                    "text": "して"
                  }
                ]
              },
              {
                "text": "近づいて",
                "performerIds": [
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "近",
                    "reading": "ちか"
                  },
                  {
                    "text": "づいて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "This burning heart... I hide it as we draw closer"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "吐息感じれば　痺れるほど",
            "zh-CN": "一旦感受到吐息 几欲麻痹窒息",
            "segments": [
              {
                "text": "吐息感じれば　痺れるほど",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "吐息感",
                    "reading": "といきかん"
                  },
                  {
                    "text": "じれば　"
                  },
                  {
                    "text": "痺",
                    "reading": "しび"
                  },
                  {
                    "text": "れるほど"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "To feel your sigh would enrapture me"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "ありふれた恋心に　今罠を仕掛けて",
            "zh-CN": "向着司空见惯的爱慕之心 此刻设下陷阱",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "ありふれた恋心に　今罠を仕掛けて",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "ありふれた"
                  },
                  {
                    "text": "恋心",
                    "reading": "こいごころ"
                  },
                  {
                    "text": "に　"
                  },
                  {
                    "text": "今罠",
                    "reading": "いまわな"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "仕掛",
                    "reading": "しか"
                  },
                  {
                    "text": "けて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Set a trap now in your ordinary love"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "僅かな隙間にも　足跡残さないよ",
            "zh-CN": "哪怕在微小的缝隙间 也不留下半点痕迹",
            "segments": [
              {
                "text": "僅かな隙間にも　足跡残さないよ",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "僅",
                    "reading": "わず"
                  },
                  {
                    "text": "かな"
                  },
                  {
                    "text": "隙間",
                    "reading": "すきま"
                  },
                  {
                    "text": "にも　"
                  },
                  {
                    "text": "足跡残",
                    "reading": "あしあとのこ"
                  },
                  {
                    "text": "さないよ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Leaving no footprints around the cracks in your defenses"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "ありふれた恋心に　今罠を仕掛ける",
            "zh-CN": "向着司空见惯的爱慕之心 此刻设下陷阱",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "ありふれた恋心に　今罠を仕掛ける",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "ありふれた"
                  },
                  {
                    "text": "恋心",
                    "reading": "こいごころ"
                  },
                  {
                    "text": "に　"
                  },
                  {
                    "text": "今罠",
                    "reading": "いまわな"
                  },
                  {
                    "text": "を"
                  },
                  {
                    "text": "仕掛",
                    "reading": "しか"
                  },
                  {
                    "text": "ける"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Set a trap now in your ordinary love"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "僅かな隙間　覗けば",
            "zh-CN": "只要窥探 那微小的缝隙",
            "segments": [
              {
                "text": "僅かな隙間　覗けば",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "僅",
                    "reading": "わず"
                  },
                  {
                    "text": "かな"
                  },
                  {
                    "text": "隙間",
                    "reading": "すきま"
                  },
                  {
                    "text": "　"
                  },
                  {
                    "text": "覗",
                    "reading": "のぞ"
                  },
                  {
                    "text": "けば"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "If I find the smallest crack,"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "捕まえて",
            "zh-CN": "就将你捕获",
            "segments": [
              {
                "text": "捕まえて",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "捕",
                    "reading": "つか"
                  },
                  {
                    "text": "まえて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "I'll catch you"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "たとえば深い茂みの中　滑り込ませて",
            "zh-CN": "譬如滑入那幽深的草丛之中",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "たとえば深い茂みの中　滑り込ませて",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "たとえば"
                  },
                  {
                    "text": "深",
                    "reading": "ふか"
                  },
                  {
                    "text": "い"
                  },
                  {
                    "text": "茂",
                    "reading": "しげ"
                  },
                  {
                    "text": "みの"
                  },
                  {
                    "text": "中",
                    "reading": "なか"
                  },
                  {
                    "text": "　"
                  },
                  {
                    "text": "滑",
                    "reading": "すべ"
                  },
                  {
                    "text": "り"
                  },
                  {
                    "text": "込",
                    "reading": "こ"
                  },
                  {
                    "text": "ませて"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "If we slipped into a deep thicket"
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "繋いだ汗の香りに　ただ侵されてる",
            "zh-CN": "仅仅被交缠的汗水香气 彻底侵蚀",
            "segments": [
              {
                "text": "繋いだ汗の香りに　ただ侵されてる",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-26"
                ],
                "ruby": [
                  {
                    "text": "繋",
                    "reading": "つな"
                  },
                  {
                    "text": "いだ"
                  },
                  {
                    "text": "汗",
                    "reading": "あせ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "香",
                    "reading": "かお"
                  },
                  {
                    "text": "りに　ただ"
                  },
                  {
                    "text": "侵",
                    "reading": "おか"
                  },
                  {
                    "text": "されてる"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "The scent of our binding sweat would surely overwhelm us"
          }
        ]
