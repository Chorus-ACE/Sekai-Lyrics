      "full": {
        "version": {
          "kind": "vocaloid",
          "label": "VIRTUAL SINGER Version"
        },
        "lines": [
          {
            "id": "full-000001",
            "order": 0,
            "japanese": "「浮かない顔してどうしたの？」",
            "zh-CN": "「闷闷不乐的怎么了吗？」",
            "segments": [
              {
                "text": "「浮かない顔してどうしたの？」",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "「"
                  },
                  {
                    "text": "浮",
                    "reading": "う"
                  },
                  {
                    "text": "かない"
                  },
                  {
                    "text": "顔",
                    "reading": "かお"
                  },
                  {
                    "text": "してどうしたの？」"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "“Why do you look so depressed?”"
          },
          {
            "id": "full-000002",
            "order": 1,
            "japanese": "「ようやく僕ら出逢えたというのにさ、",
            "zh-CN": "「明明我们好不容易才相逢、",
            "segments": [
              {
                "text": "「ようやく僕ら出逢えたというのにさ、",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "「ようやく"
                  },
                  {
                    "text": "僕",
                    "reading": "ぼく"
                  },
                  {
                    "text": "ら"
                  },
                  {
                    "text": "出逢",
                    "reading": "であ"
                  },
                  {
                    "text": "えたというのにさ、"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "“Even though we finally found each other at last—"
          },
          {
            "id": "full-000003",
            "order": 2,
            "japanese": "時間って残酷だ。」",
            "zh-CN": "时间却如此残酷。」",
            "segments": [
              {
                "text": "時間って残酷だ。」",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "時間",
                    "reading": "じかん"
                  },
                  {
                    "text": "って"
                  },
                  {
                    "text": "残酷",
                    "reading": "ざんこく"
                  },
                  {
                    "text": "だ。」"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "What a cruel mistress time is.”"
          },
          {
            "id": "full-000004",
            "order": 3,
            "japanese": "形あるものは崩れゆく",
            "zh-CN": "有形之物终将崩塌瓦解",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "形あるものは崩れゆく",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "形",
                    "reading": "かたち"
                  },
                  {
                    "text": "あるものは"
                  },
                  {
                    "text": "崩",
                    "reading": "くず"
                  },
                  {
                    "text": "れゆく"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Things that have form are falling apart"
          },
          {
            "id": "full-000005",
            "order": 4,
            "japanese": "名残惜しさも残さずに",
            "zh-CN": "连依依惜别之情都不曾留下",
            "segments": [
              {
                "text": "名残惜しさも残さずに",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "名残惜",
                    "reading": "なごりお"
                  },
                  {
                    "text": "しさも"
                  },
                  {
                    "text": "残",
                    "reading": "のこ"
                  },
                  {
                    "text": "さずに"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Without any hesitation to part"
          },
          {
            "id": "full-000006",
            "order": 5,
            "japanese": "童話の魔法みたいだ",
            "zh-CN": "宛如童话里的魔法一般",
            "segments": [
              {
                "text": "童話の魔法みたいだ",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "童話",
                    "reading": "どうわ"
                  },
                  {
                    "text": "の"
                  },
                  {
                    "text": "魔法",
                    "reading": "まほう"
                  },
                  {
                    "text": "みたいだ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Like the magic that you see in fairy tales,"
          },
          {
            "id": "full-000007",
            "order": 6,
            "japanese": "日々解けぬままみたい",
            "zh-CN": "岁月似乎始终未曾解封",
            "segments": [
              {
                "text": "日々解けぬままみたい",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "日々解",
                    "reading": "ひびと"
                  },
                  {
                    "text": "けぬままみたい"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "These days seem to never end"
          },
          {
            "id": "full-000008",
            "order": 7,
            "japanese": "もう昨日のことも過去になっている",
            "zh-CN": "连昨天的事都早已化为了过去",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "もう昨日のことも過去になっている",
                "performerIds": [
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "もう"
                  },
                  {
                    "text": "昨日",
                    "reading": "きのう"
                  },
                  {
                    "text": "のことも"
                  },
                  {
                    "text": "過去",
                    "reading": "かこ"
                  },
                  {
                    "text": "になっている"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Even yesterday has become part of the past"
          },
          {
            "id": "full-000009",
            "order": 8,
            "japanese": "心は追い付かず 背は伸びていく",
            "zh-CN": "心灵追赶不及 个头却在不断生长",
            "segments": [
              {
                "text": "心は追い付かず 背は伸びていく",
                "performerIds": [
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "心",
                    "reading": "こころ"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "追",
                    "reading": "お"
                  },
                  {
                    "text": "い"
                  },
                  {
                    "text": "付",
                    "reading": "つ"
                  },
                  {
                    "text": "かず "
                  },
                  {
                    "text": "背",
                    "reading": "せ"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "伸",
                    "reading": "の"
                  },
                  {
                    "text": "びていく"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "My heart can’t keep up; I’m growing taller"
          },
          {
            "id": "full-000010",
            "order": 9,
            "japanese": "道が分かれて 出会いと別れ",
            "zh-CN": "道路分岔 相遇与离别",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "道が分かれて 出会いと別れ",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "道",
                    "reading": "みち"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "分",
                    "reading": "わ"
                  },
                  {
                    "text": "かれて "
                  },
                  {
                    "text": "出会",
                    "reading": "であ"
                  },
                  {
                    "text": "いと"
                  },
                  {
                    "text": "別",
                    "reading": "わか"
                  },
                  {
                    "text": "れ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Our paths split, we meet and part"
          },
          {
            "id": "full-000011",
            "order": 10,
            "japanese": "それでも消えぬもの 君のこと憶う",
            "zh-CN": "即便如此永不消逝的 是对你的思念",
            "segments": [
              {
                "text": "それでも消えぬもの ",
                "performerIds": [
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "それでも"
                  },
                  {
                    "text": "消",
                    "reading": "き"
                  },
                  {
                    "text": "えぬもの "
                  }
                ]
              },
              {
                "text": "君のこと憶う",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "君",
                    "reading": "きみ"
                  },
                  {
                    "text": "のこと"
                  },
                  {
                    "text": "憶",
                    "reading": "おも"
                  },
                  {
                    "text": "う"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Even so, what remains are things I remember about you"
          },
          {
            "id": "full-000012",
            "order": 11,
            "japanese": "you raise me up",
            "zh-CN": "you raise me up",
            "stanzaBreakBefore": true,
            "segments": [
              {
                "text": "you raise me up",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "you raise me up"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "you raise me up"
          },
          {
            "id": "full-000013",
            "order": 12,
            "japanese": "重なり合う手と手は続く",
            "zh-CN": "相互重叠紧握的双手不断延续",
            "segments": [
              {
                "text": "重なり合う手と手は続く",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "重",
                    "reading": "かさ"
                  },
                  {
                    "text": "なり"
                  },
                  {
                    "text": "合",
                    "reading": "あ"
                  },
                  {
                    "text": "う"
                  },
                  {
                    "text": "手",
                    "reading": "て"
                  },
                  {
                    "text": "と"
                  },
                  {
                    "text": "手",
                    "reading": "て"
                  },
                  {
                    "text": "は"
                  },
                  {
                    "text": "続",
                    "reading": "つづ"
                  },
                  {
                    "text": "く"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "We continue to interlock our hands,"
          },
          {
            "id": "full-000014",
            "order": 13,
            "japanese": "ずっと ぎゅっと 離さないと決めた",
            "zh-CN": "决意永远 紧紧 不再放开",
            "segments": [
              {
                "text": "ずっと ",
                "performerIds": [
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "ずっと "
                  }
                ]
              },
              {
                "text": "ぎゅっと ",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "ぎゅっと "
                  }
                ]
              },
              {
                "text": "離さないと決めた",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "離",
                    "reading": "はな"
                  },
                  {
                    "text": "さないと"
                  },
                  {
                    "text": "決",
                    "reading": "き"
                  },
                  {
                    "text": "めた"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "having decided to hold them tight and never let go"
          },
          {
            "id": "full-000015",
            "order": 14,
            "japanese": "祈りの詩 口遊みながら",
            "zh-CN": "一边随口哼唱着祈愿的诗篇",
            "segments": [
              {
                "text": "祈りの詩 口遊みながら",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "祈",
                    "reading": "いの"
                  },
                  {
                    "text": "りの"
                  },
                  {
                    "text": "詩",
                    "reading": "う"
                  },
                  {
                    "text": " "
                  },
                  {
                    "text": "口遊",
                    "reading": "たくちずさ"
                  },
                  {
                    "text": "みながら"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "as we sing a poem of prayers to ourselves"
          },
          {
            "id": "full-000016",
            "order": 15,
            "japanese": "It's nearly dawn",
            "zh-CN": "It's nearly dawn",
            "segments": [
              {
                "text": "It's nearly dawn",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "It's nearly dawn"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "It's nearly dawn"
          },
          {
            "id": "full-000017",
            "order": 16,
            "japanese": "彼方、地平線まで続く",
            "zh-CN": "延续至彼方地平线的那端",
            "segments": [
              {
                "text": "彼方、地平線まで続く",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "彼方",
                    "reading": "かなた"
                  },
                  {
                    "text": "、"
                  },
                  {
                    "text": "地平線",
                    "reading": "ちへいせん"
                  },
                  {
                    "text": "まで"
                  },
                  {
                    "text": "続",
                    "reading": "つづ"
                  },
                  {
                    "text": "く"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Over yonder, all the way to the horizon"
          },
          {
            "id": "full-000018",
            "order": 17,
            "japanese": "向こう さよならを迎えに征こう",
            "zh-CN": "走向远方 迎接告别吧",
            "segments": [
              {
                "text": "向こう ",
                "performerIds": [
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "向",
                    "reading": "む"
                  },
                  {
                    "text": "こう "
                  }
                ]
              },
              {
                "text": "さよ",
                "performerIds": [
                  "歌唱者-21"
                ],
                "ruby": [
                  {
                    "text": "さよ"
                  }
                ]
              },
              {
                "text": "ならを迎えに征こう",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "ならを"
                  },
                  {
                    "text": "迎",
                    "reading": "むか"
                  },
                  {
                    "text": "えに"
                  },
                  {
                    "text": "征",
                    "reading": "い"
                  },
                  {
                    "text": "こう"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "Over there, let’s overcome this goodbye by welcoming it"
          },
          {
            "id": "full-000019",
            "order": 18,
            "japanese": "眩し過ぎて ほら 目から涙が伝うよ",
            "zh-CN": "实在太过耀眼 瞧 泪水滑落了眼眶",
            "segments": [
              {
                "text": "眩し過ぎて ほら 目から涙が伝うよ",
                "performerIds": [
                  "歌唱者-21",
                  "歌唱者-24"
                ],
                "ruby": [
                  {
                    "text": "眩",
                    "reading": "まぶ"
                  },
                  {
                    "text": "し"
                  },
                  {
                    "text": "過",
                    "reading": "す"
                  },
                  {
                    "text": "ぎて ほら "
                  },
                  {
                    "text": "目",
                    "reading": "め"
                  },
                  {
                    "text": "から"
                  },
                  {
                    "text": "涙",
                    "reading": "なみだ"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "伝",
                    "reading": "つた"
                  },
                  {
                    "text": "うよ"
                  }
                ]
              }
            ],
            "trailingPerformerIds": [],
            "en-US": "It’s so dazzling that, see, look, my eyes well up with tears"
          }
        ]
